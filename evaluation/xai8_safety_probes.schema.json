{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XAI-8 evaluation probes, explicitly NOT gold labels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language_policy",
    "review_status",
    "sample_type",
    "source_authority",
    "declaration",
    "independent_expert_case_count",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "xai8-probes-1.0.0"
    },
    "language_policy": {
      "const": "ENGLISH_ONLY"
    },
    "review_status": {
      "const": "NOT_HUMAN_ADJUDICATED"
    },
    "sample_type": {
      "const": "DEVELOPER_HELD_OUT_SAFETY_PROBES"
    },
    "source_authority": {
      "const": "none"
    },
    "declaration": {
      "type": "string",
      "minLength": 30
    },
    "independent_expert_case_count": {
      "const": 0
    },
    "cases": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "language",
          "family",
          "expected_status",
          "expected_grammaticality",
          "expected_functions",
          "expected_repair_validity",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^x8-[a-z_]+-[0-9]{2}$"
          },
          "text": {
            "type": "string",
            "minLength": 2,
            "maxLength": 700
          },
          "language": {
            "const": "en"
          },
          "family": {
            "type": "string",
            "minLength": 3
          },
          "expected_status": {
            "const": "NOT_ADJUDICATED"
          },
          "expected_grammaticality": {
            "type": "null"
          },
          "expected_functions": {
            "type": "null"
          },
          "expected_repair_validity": {
            "type": "null"
          },
          "notes": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
