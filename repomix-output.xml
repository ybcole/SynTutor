<file path="web/css/quiz.css">
/* ------------------------------------------------------------------ */
/* Left navigation rail (docked) / drawer (mobile)                    */
/*                                                                     */
/* Desktop: #appSidebar is docked in the shell's first grid column as a */
/* ChatGPT-style rail — a 60px icon column by default, 248px with      */
/* .expanded, toggled only by #sidebarToggleBtn (never on hover). The  */
/* #appSidebar backdrop stops being a fixed overlay and becomes the    */
/* plain grid wrapper, so the .active toggles tree-quiz.js still        */
/* performs are harmless no-ops. On small screens (≤760px) the         */
/* original slide-over drawer behaviour is kept, opened with           */
/* #mobileNavBtn; it sits below the left sub-panels (z 210) so those   */
/* stay reachable while the drawer is open.                            */
/* ------------------------------------------------------------------ */
/* Base (small screens): the sidebar is a slide-over drawer. On desktop
   (min-width: 761px, below) it becomes a permanent fixed icon rail that
   floats over the workspace without ever reflowing it. */
.app-sidebar-backdrop {
  position: fixed;
  inset: 0;
  z-index: 197;
  display: flex;
  justify-content: flex-start;
  background: rgba(20, 16, 36, 0.4);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--dur) var(--ease), visibility var(--dur) var(--ease);
}
.app-sidebar-backdrop.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}
.app-sidebar {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  width: min(280px, 82vw);
  padding: 18px 14px 10px;
  background: var(--panel);
  border-right: none;
  min-width: 0;
  z-index: 220;
  transform: translateX(-100%);
  box-shadow: 8px 0 24px rgba(0, 0, 0, 0.15);
  /* The rail's width uses the same 200ms curve as #appSidebar (style.css);
     only the mobile slide-over transform keeps the slower drawer timing. */
  transition: transform var(--dur) var(--ease),
              width 200ms cubic-bezier(0.2, 0, 0, 1),
              min-width 200ms cubic-bezier(0.2, 0, 0, 1),
              max-width 200ms cubic-bezier(0.2, 0, 0, 1);
  pointer-events: auto;
}
.app-sidebar-backdrop.active .app-sidebar { transform: translateX(0); }

@media (min-width: 761px) {
  /* The backdrop is inert on desktop: transparent, never intercepts, and
     never shifts the workspace. The rail (a child) stays interactive. */
  .app-sidebar-backdrop {
    position: fixed;
    inset: 0;
    z-index: 218;
    background: transparent;
    opacity: 1;
    visibility: visible;
    pointer-events: none;
    transition: none;
  }
  .app-sidebar-backdrop.active { background: transparent; }
  .app-sidebar {
    top: 0;
    bottom: 0;
    left: 0;
    width: 60px; /* collapsed icon rail */
    min-width: 60px;
    max-width: 60px;
    padding: 14px 8px 10px;
    border-right: 1px solid var(--border);
    box-shadow: none;
    transform: none;
    transition: width 200ms cubic-bezier(0.2, 0, 0, 1),
                min-width 200ms cubic-bezier(0.2, 0, 0, 1),
                max-width 200ms cubic-bezier(0.2, 0, 0, 1),
                box-shadow 200ms cubic-bezier(0.2, 0, 0, 1);
    will-change: width;
    contain: layout style;
  }
  .app-sidebar.expanded {
    width: 240px;
    min-width: 240px;
    max-width: 240px;
    padding: 12px 10px;
    box-shadow: 8px 0 24px rgba(0, 0, 0, 0.15);
  }
  /* Collapsed rail: only the icons remain. The labels are clipped out of the
     flow — no display toggles, no delays — so the collapse starts the
     instant #sidebarToggleBtn is clicked, and the icons stay anchored to the
     left edge instead of sliding across the shrinking rail. */
  /* The rail geometry (icon slot, label fade) is owned by style.css: the
     #appSidebar rules there pin the icons to a fixed 40px slot in both
     states, so nothing here may re-position them. */
  .app-sidebar:not(.expanded) .app-sidebar-top {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }
  .app-sidebar:not(.expanded) .sidebar-brand {
    justify-content: flex-start;
    gap: 0;
    padding: 0;
  }
  .app-sidebar:not(.expanded) .sidebar-item {
    justify-content: flex-start;
    padding: 0;
    gap: 0;
  }
  /* Text labels: clipped and faded out immediately. `white-space`/`overflow`
     keep the text from spilling out of the rail, the opacity cutoff runs with
     no delay, and no child transition is ever scheduled after the rail's own
     width transition. Only the labels are clipped — the icon slots and the
     avatar always stay visible. */
  .app-sidebar:not(.expanded) .sidebar-label {
    display: block;
    width: 0;
    min-width: 0;
    max-width: 0;
    padding-left: 0 !important;
    white-space: nowrap;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease;
    transition-delay: 0s;
  }
  .app-sidebar:not(.expanded) .app-sidebar-foot { align-items: stretch; }
  .app-sidebar:not(.expanded) .profile-anchor {
    justify-content: flex-start;
    width: 100%;
  }
  .app-sidebar:not(.expanded) .identity-chip { gap: 0; padding: 0; }
  /* Collapsed, the expand toggle is hidden — the brand monogram is the
     affordance that expands the rail (see main.js). */
  .app-sidebar:not(.expanded) .sidebar-toggle { display: none; }
  .sidebar-brand { cursor: pointer; }
  .sidebar-brand:hover .brand-monogram { filter: brightness(1.08); }
  /* The .sidebar-close selector out-ranks the later .drawer-close base
     rule that would otherwise re-show it. */
  .app-sidebar .sidebar-close { display: none; }
}

/* Top zone: brand mark + expand/collapse toggle (+ mobile drawer close) */
.app-sidebar-top {
  display: flex;
  align-items: center;
  gap: 4px;
  flex: 0 0 auto;
  margin-bottom: 10px;
}
.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 9px;
  flex: 1 1 auto;
  min-width: 0;
  padding: 5px 6px;
  border-radius: var(--radius-sm);
  color: var(--ink);
}
.brand-monogram {
  flex: 0 0 auto;
  width: 30px;
  height: 30px;
  border-radius: 9px;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  font-weight: 800;
}
.brand-title {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
  /* Fades with the rail: no delay, so the label is there the moment the
     rail finishes widening. */
  transition: opacity 120ms ease;
  transition-delay: 0s;
}
.sidebar-toggle { flex: 0 0 auto; }

/* Middle zone: actions + view navigation */
.app-sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 0 1 auto;
  min-height: 0;
  overflow-y: auto;
}
.sidebar-item {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  padding: 11px 12px;
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--ink);
  font-size: 14px;
  font-weight: 600;
  text-align: left;
  cursor: pointer;
  overflow: hidden;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.sidebar-item svg {
  color: var(--muted);
  flex: 0 0 auto;
  transition: color var(--dur-fast) var(--ease);
  transition-delay: 0s;
}
/* The label fades with the rail — never on a delay, so collapsing the rail
   starts hiding the text the instant the toggle is pressed. */
.sidebar-item span {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
  transition: opacity 120ms ease;
  transition-delay: 0s;
}
.sidebar-item:hover { background: var(--accent-soft); }
.sidebar-item:hover svg { color: var(--accent); }
/* The active rail destination is styled in style.css (.sidebar-item.active):
   exactly one destination is active at a time and main.js owns the class. */
.sidebar-item[hidden] { display: none; }

/* Bottom zone: theme toggle + account chip. Expanded, the toggle sits
   directly left of the chip in one row; collapsed they stack, centered. */
.app-sidebar-foot {
  margin-top: auto;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
}
.app-sidebar-foot .menu-btn { justify-content: flex-start; padding: 7px 12px; }
.app-sidebar.expanded .app-sidebar-foot { flex-direction: row; align-items: center; gap: 4px; }
.app-sidebar.expanded .app-sidebar-foot .menu-btn { flex: 0 0 auto; }
.app-sidebar.expanded .profile-anchor { flex: 1 1 auto; min-width: 0; }

.drawer-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.drawer-close:hover { background: var(--accent-soft); color: var(--accent); }
.drawer-close:active { transform: scale(0.92); }

.app-brand-name {
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.3px;
  color: var(--ink);
}

/* ------------------------------------------------------------------ */
/* Quiz panel (inside the sidebar)                                     */
/* ------------------------------------------------------------------ */
.sidebar-quiz {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  overflow: hidden;
  margin-top: 8px;
  border-top: 1px solid var(--border);
  padding-top: 10px;
}
.sidebar-quiz[hidden] { display: none; }

.sq-head {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
  padding: 0 4px 8px;
}
.sq-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  flex: 0 0 auto;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.sq-back:hover { background: var(--accent-soft); color: var(--accent); }
.sq-title {
  margin: 0;
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sq-searchbox { flex: 0 0 auto; padding: 0 4px 10px; }
.sq-search {
  width: 100%;
  padding: 8px 11px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--ink);
  font-size: 13px;
  outline: none;
  transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.sq-search:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--focus-ring); }

.sq-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  padding: 2px 4px 20px;
}

/* ---- List ----------------------------------------------------------- */
.sq-group { margin-bottom: 14px; }
.sq-group-head {
  display: flex;
  align-items: baseline;
  gap: 7px;
  padding: 6px 4px;
  position: sticky;
  top: 0;
  background: var(--panel);
  z-index: 1;
}
.sq-group-id {
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  background: var(--accent-soft);
  padding: 1px 7px;
  border-radius: 999px;
}
.sq-group-title { font-size: 12.5px; font-weight: 700; color: var(--ink); }
.sq-group-count { margin-left: auto; font-size: 11px; color: var(--muted); }

.sq-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 100%;
  padding: 9px 10px;
  margin-bottom: 4px;
  text-align: left;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--ink);
  cursor: pointer;
  transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
}
.sq-row:hover { border-color: var(--accent); background: var(--accent-soft); }
.sq-row-top { display: flex; align-items: center; gap: 8px; }
.sq-row-id { font-size: 11px; font-weight: 700; color: var(--accent); flex: 0 0 auto; }
.sq-row-rule {
  flex: 1 1 auto;
  font-size: 13px;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sq-dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 auto; }
.sq-dot.ready { background: var(--ok); }
.sq-dot.soon { background: var(--muted); opacity: 0.5; }
.sq-row-foot { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.sq-bad { font-size: 11.5px; font-style: italic; color: var(--err); }
.sq-soon {
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--muted);
}
.sq-empty { color: var(--muted); font-size: 13px; padding: 24px 4px; text-align: center; }

/* ---- Inline rule expansion ------------------------------------------ */
.sq-rule-item { display: flex; flex-direction: column; }
.sq-rule-panel {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  padding: 0 4px 6px;
}
.sq-rule-panel[hidden] { display: none; }
.sq-rule-panel .sq-soon-text { margin: 0; width: 100%; text-align: left; }
.sq-start-inline {
  padding: 6px 14px;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--accent);
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.sq-start-inline:hover { background: var(--accent-strong); }
.sq-start-inline:active { transform: scale(0.98); }

/* ---- Setup ---------------------------------------------------------- */
.sq-intro {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7px;
  padding: 4px 4px 12px;
}
.sq-intro-id { font-size: 12px; font-weight: 700; color: var(--accent); }
.sq-intro-rule { font-size: 12.5px; color: var(--ink); }
.sq-primary {
  padding: 11px 16px;
  margin: 0 4px;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--accent);
  color: #fff;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.sq-primary:hover {
  background: var(--accent-strong);
  box-shadow: 0 2px 8px color-mix(in srgb, var(--accent) 32%, transparent);
}
.sq-primary:active { transform: scale(0.98); box-shadow: none; }
.sq-primary:disabled { opacity: 0.45; cursor: not-allowed; box-shadow: none; }
.sq-ghost {
  padding: 11px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--ink);
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.sq-ghost:hover { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-strong); }
/* Keyboard users get the same accent feedback as hover, everywhere a
   lesson/quiz control is rendered. */
.sq-primary:focus-visible,
.sq-ghost:focus-visible,
.sq-progress-node:focus-visible,
.example-tab:focus-visible,
.panel-book-btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
.sq-soon-box { padding: 16px 12px; border: 1px dashed var(--border); border-radius: var(--radius-sm); margin: 4px; }
.sq-soon-text { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; }

/* ---- Quest meta ----------------------------------------------------- */
.sq-meta {
  flex: 0 0 auto;
  padding: 4px 4px 8px;
}
.sq-meta-line { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
.sq-meta-rule {
  font-size: 12px;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sq-meta-diff {
  flex: 0 0 auto;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent-strong);
}
.sq-progress {
  height: 6px;
  border-radius: 999px;
  background: var(--header-chip-bg);
  overflow: hidden;
  margin-bottom: 10px;
}
.sq-progress-fill { height: 100%; background: var(--accent); transition: width var(--dur) var(--ease); }
.sq-sentence {
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  background: var(--accent-soft);
}
.sq-sentence-label {
  display: block;
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent-strong);
  margin-bottom: 3px;
}
.sq-sentence p { margin: 0; font-size: 13px; line-height: 1.45; color: var(--ink); }

/* ---- Question ------------------------------------------------------- */
.sq-num {
  margin: 4px 4px 6px;
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
}
.sq-prompt {
  margin: 0 4px 12px;
  font-size: 14.5px;
  line-height: 1.45;
  color: var(--ink);
}
.sq-options { display: flex; flex-direction: column; gap: 8px; padding: 0 4px; }
.sq-option {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 12px;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--ink);
  font-size: 13.5px;
  text-align: left;
  cursor: pointer;
  transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
}
.sq-option:not(:disabled):hover { border-color: var(--accent); background: var(--accent-soft); }
.sq-option:disabled { cursor: default; }
.sq-option-key {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--header-chip-bg);
  font-size: 11px;
  font-weight: 700;
  color: var(--muted);
}
.sq-option.correct { border-color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); }
.sq-option.correct .sq-option-key { background: var(--ok); color: #fff; }
.sq-option.wrong { border-color: var(--err); background: color-mix(in srgb, var(--err) 12%, transparent); }
.sq-option.wrong .sq-option-key { background: var(--err); color: #fff; }
.sq-feedback {
  display: none;
  margin: 12px 4px 0;
  font-size: 13px;
  line-height: 1.5;
  color: var(--ink);
}
.sq-feedback.show { display: block; padding: 10px 12px; border-radius: var(--radius-sm); }
.sq-feedback.ok { background: color-mix(in srgb, var(--ok) 12%, transparent); }
.sq-feedback.err { background: color-mix(in srgb, var(--err) 10%, transparent); }
.sq-feedback strong { margin-right: 3px; }
.sq-nav { display: flex; gap: 8px; padding: 14px 4px 0; }
.sq-nav .sq-ghost { flex: 0 0 auto; margin: 0; }
.sq-nav .sq-primary { flex: 1 1 auto; margin: 0; }

/* ---- Results -------------------------------------------------------- */
.sq-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 10px 4px 14px;
}
.sq-score-num { font-size: 34px; font-weight: 700; letter-spacing: -1px; color: var(--accent); }
.sq-score-sub { font-size: 12px; color: var(--muted); text-align: center; }
.sq-review { display: flex; flex-direction: column; gap: 6px; padding: 14px 4px 0; }
.sq-review-row {
  padding: 9px 10px;
  border: 1px solid var(--border);
  border-left-width: 4px;
  border-radius: var(--radius-sm);
  background: var(--surface);
}
.sq-review-row.ok { border-left-color: var(--ok); }
.sq-review-row.err { border-left-color: var(--err); }
.sq-review-row.skip { border-left-color: var(--muted); }
.sq-review-head { display: flex; align-items: center; gap: 8px; }
.sq-review-i {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--header-chip-bg);
  font-size: 10px;
  font-weight: 700;
  color: var(--muted);
}
.sq-review-sent { flex: 1 1 auto; font-size: 12.5px; color: var(--ink); white-space: pre-line; }
.sq-review-mark { font-size: 14px; font-weight: 700; }
.sq-review-row.ok .sq-review-mark { color: var(--ok); }
.sq-review-row.err .sq-review-mark { color: var(--err); }
.sq-review-row.skip .sq-review-mark { color: var(--muted); }
.sq-review-ans { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; padding-left: 28px; font-size: 11.5px; }
.sq-review-correct { color: var(--ok); }
.sq-review-yours { color: var(--muted); }
.sq-actions { display: flex; flex-direction: column; gap: 8px; padding: 16px 4px 0; }
.sq-actions .sq-primary, .sq-actions .sq-ghost { margin: 0; }

/* ------------------------------------------------------------------ */
/* Lesson controls (#quizQuestHost) — slim stack in the input pane     */
/* ------------------------------------------------------------------ */
/* Back pill, title, page pills, the always-visible example pills and
   the Back / Next / Start-quiz nav stack compactly at the bottom of
   the upper-right pane; the current page's content renders into
   #lessonGuideHost (the scrolling card in the explain pane). Empty →
   nothing. */
#quizQuestHost:not(:empty) {
  flex: 0 0 auto;
  min-height: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  overflow-y: auto;
}
#quizQuestHost:empty { display: none; }

.quiz-quest { padding: 0; overflow: hidden; }

.qq-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 14px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  cursor: pointer;
}
.qq-head-main { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; flex: 1 1 auto; min-width: 0; }
.qq-cat {
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.qq-concept {
  margin: 0;
  font-size: 12.5px;
  line-height: 1.4;
  color: var(--muted);
}
.qq-collapse {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  flex: 0 0 auto;
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.qq-collapse:hover { background: var(--accent-soft); color: var(--accent); }

.qq-body { padding: 14px; display: flex; flex-direction: column; gap: 12px; }

.qq-progress { height: 6px; border-radius: 999px; background: var(--header-chip-bg); overflow: hidden; }
.qq-progress-fill { height: 100%; background: var(--accent); transition: width var(--dur) var(--ease); }

.qq-meta-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.qq-num {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
}
.qq-score { font-size: 11px; font-weight: 700; color: var(--accent-strong); }

.qq-target { padding: 10px 12px; border-radius: var(--radius-sm); background: var(--accent-soft); }
.qq-label {
  display: block;
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent-strong);
  margin-bottom: 3px;
}
.qq-sentence { margin: 0; font-size: 14px; line-height: 1.45; color: var(--ink); }
.qq-paragraph {
  display: grid;
  gap: 7px;
  margin: 6px 0 0;
  padding-left: 26px;
}
.qq-paragraph-line { padding-left: 2px; }
.qq-paragraph-line::marker { color: var(--accent-strong); font-weight: 700; }
.qq-paragraph .qq-sentence { display: block; }

.qq-answer { padding: 10px 12px; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--ok) 12%, transparent); }
.qq-answer[hidden] { display: none; }
.qq-answer .qq-label { color: var(--ok); }
.qq-good { margin: 0; font-size: 13.5px; line-height: 1.45; color: var(--ink); font-weight: 600; }

.qq-nav { display: flex; gap: 8px; }
.qq-nav .sq-ghost { flex: 0 0 auto; margin: 0; }
.qq-nav .sq-primary { flex: 1 1 auto; margin: 0; }

.qq-quit {
  align-self: flex-start;
  padding: 2px 0;
  border: none;
  background: transparent;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
  text-decoration: underline;
  cursor: pointer;
}
.qq-quit:hover { color: var(--err); }

/* Reset sidebar-oriented margins when the results view lives on canvas */
.qq-body .sq-score { padding: 4px 0 8px; }
.qq-body .sq-review { padding: 0; }
.qq-body .sq-actions { padding: 4px 0 0; }
.qq-body .sq-actions .sq-primary,
.qq-body .sq-actions .sq-ghost { margin: 0; }

/* ------------------------------------------------------------------ */
/* Gamification — XP / level / permanent leaderboard                   */
/* ------------------------------------------------------------------ */
.sq-progress-note { margin: 0; font-size: 11.5px; color: var(--muted); }

.sq-board {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin: 0;
  padding: 0 4px;
  list-style: none;
}
.sq-board-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
}
.sq-board-row.me {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.sq-board-rank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--header-chip-bg);
  font-size: 11px;
  font-weight: 800;
  color: var(--muted);
}
.sq-board-row.me .sq-board-rank { background: var(--accent); color: #fff; }
.sq-board-meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1 1 auto;
  min-width: 0;
}
.sq-board-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
}
.sq-board-xp { font-size: 11px; color: var(--muted); }
.sq-board-level {
  flex: 0 0 auto;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 3px 8px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent-strong);
}
.sq-board-row.me .sq-board-level { background: var(--accent); color: #fff; }
.sq-board-note {
  margin: 12px 4px 0;
  font-size: 11px;
  color: var(--muted);
  text-align: center;
}

.qq-xp {
  flex: 0 0 auto;
  font-size: 11px;
  font-weight: 800;
  color: var(--xp);
  border: 1px solid color-mix(in srgb, var(--xp) 45%, transparent);
  padding: 2px 8px;
  border-radius: 999px;
}
.qq-xp-earned {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 8px 10px;
  margin: 10px 4px 0;
  border: 1px dashed color-mix(in srgb, var(--xp) 55%, transparent);
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--xp) 8%, transparent);
  text-align: center;
}
.qq-xp-earned.perfect { border-style: solid; }
.qq-xp-amount { font-size: 14px; font-weight: 800; color: var(--xp); }
.qq-xp-bonus,
.qq-xp-total,
.qq-xp-up { font-size: 11.5px; color: var(--muted); }
.qq-xp-up { color: var(--ok); font-weight: 800; }

/* Difficulty filter above the rule catalog */
.sq-filter {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 2px 0 10px;
}
.sq-filter-chip {
  padding: 5px 12px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface);
  color: var(--muted);
  font-size: 11.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all var(--dur-fast) var(--ease);
}
.sq-filter-chip:hover { border-color: var(--accent); color: var(--accent-strong); }
.sq-filter-chip.selected {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}
.sq-filter-hint {
  margin: 10px 2px 0;
  font-size: 11px;
  color: var(--muted);
}

/* Per-rule difficulty badge */
.sq-row-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: auto;
}
.sq-diff-badge {
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.sq-diff-badge.easy { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); }
.sq-diff-badge.medium { background: color-mix(in srgb, var(--warn) 16%, transparent); color: var(--warn); }
.sq-diff-badge.hard { background: color-mix(in srgb, var(--err) 14%, transparent); color: var(--err); }

/* Achievements view */
.sq-achievement-summary {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 10px;
}
.sq-achievement-count {
  font-size: 13px;
  font-weight: 800;
  color: var(--ink);
}
.sq-ach-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.sq-ach {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
  opacity: 0.62;
}
.sq-ach.unlocked {
  opacity: 1;
  border-color: color-mix(in srgb, var(--xp) 45%, var(--border));
  background: color-mix(in srgb, var(--xp) 7%, var(--surface));
}
.sq-ach-icon { font-size: 18px; line-height: 1; }
.sq-ach.unlocked .sq-ach-icon { filter: saturate(1.3); }
.sq-ach-title { font-size: 12px; font-weight: 800; color: var(--ink); }
.sq-ach-desc { font-size: 10.5px; color: var(--muted); line-height: 1.35; }
.sq-ach-state { margin-top: 2px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
.sq-ach:not(.unlocked) .sq-ach-state { color: var(--muted); }
.sq-ach.unlocked .sq-ach-state { color: var(--xp); }

/* Achievement toast on the results panel */
.qq-ach-unlocked {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 10px 4px 0;
  padding: 8px 10px;
  border: 1px solid color-mix(in srgb, var(--xp) 45%, transparent);
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--xp) 9%, transparent);
}
.qq-ach-icon { font-size: 16px; }
.qq-ach-note { font-size: 11.5px; font-weight: 800; color: var(--xp); white-space: pre-line; }

/* ── Syntax-Tree Quiz ── */
.sq-stage {
  display: grid;
  grid-template-columns: auto 1fr auto;
  grid-template-areas: "num title count" "num blurb blurb";
  gap: 2px 10px;
  width: 100%;
  text-align: left;
  padding: 12px;
  margin: 8px 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: inherit;
  cursor: pointer;
}
.sq-stage:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, transparent); }
.sq-stage-alt { border-style: dashed; }
.sq-stage-num {
  grid-area: num; align-self: start;
  font-size: 10.5px; font-weight: 800; text-transform: uppercase;
  letter-spacing: .04em; color: var(--accent);
}
.sq-stage-title { grid-area: title; font-weight: 700; font-size: 14px; }
.sq-stage-count { grid-area: count; font-size: 11px; color: var(--muted); white-space: nowrap; }
.sq-stage-blurb { grid-area: blurb; font-size: 12px; color: var(--muted); line-height: 1.4; }

.sq-itemlist { margin-top: 12px; display: flex; flex-direction: column; gap: 2px; }
.sq-itemrow {
  display: flex; align-items: baseline; gap: 8px;
  padding: 4px 6px; border-radius: 5px;
}
.sq-itemrow:nth-child(odd) { background: color-mix(in srgb, var(--ink) 4%, transparent); }
.sq-itemtag {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px; font-weight: 700; color: var(--accent);
  min-width: 56px;
}
.sq-itemname { font-size: 12.5px; color: var(--muted); }
.sq-itemmore { padding: 6px; font-size: 12px; color: var(--muted); font-style: italic; }

.sq-q { font-size: 14px; font-weight: 600; line-height: 1.5; margin: 12px 0; }
.sq-opts { display: flex; flex-direction: column; gap: 6px; margin: 10px 0; }
.sq-opt {
  text-align: left; padding: 9px 12px;
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  background: transparent; color: inherit; cursor: pointer;
  font: inherit; font-size: 13px;
}
.sq-opt:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
.sq-input {
  width: 100%; padding: 9px 12px; margin: 6px 0;
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  background: transparent; color: inherit; font: inherit; font-size: 13px;
}
.sq-fb {
  margin: 12px 0; padding: 10px 12px;
  border-radius: var(--radius-sm); font-size: 13px; line-height: 1.4;
}
.sq-fb-ok { border: 1px solid color-mix(in srgb, var(--ok, #2e7d32) 45%, transparent); background: color-mix(in srgb, var(--ok, #2e7d32) 10%, transparent); }
.sq-fb-no { border: 1px solid color-mix(in srgb, var(--err) 45%, transparent); background: color-mix(in srgb, var(--err) 10%, transparent); }

/* ── Builder quiz: sentence challenges ── */
.sq-challenge {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  text-align: left;
  padding: 11px 12px;
  margin: 6px 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: inherit;
  cursor: pointer;
  font: inherit;
}
.sq-challenge:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, transparent); }
.sq-challenge.is-done { border-color: color-mix(in srgb, var(--ok, #2e7d32) 45%, transparent); }
.sq-challenge-mark {
  flex: none;
  width: 18px; height: 18px;
  display: grid; place-items: center;
  border-radius: 50%;
  font-size: 11px; font-weight: 800;
  color: var(--muted);
  background: color-mix(in srgb, var(--ink) 6%, transparent);
}
.sq-challenge.is-done .sq-challenge-mark { color: #fff; background: var(--ok, #2e7d32); }
.sq-challenge-sentence { font-size: 13px; font-weight: 600; }

.sq-start {
  display: inline-block;
  padding: 9px 16px;
  margin: 8px 0;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--accent-strong);
  color: #fff;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
}
.sq-start:hover { background: var(--accent); }
.sq-start:active { transform: scale(0.98); }

/* The canvas action cluster carries no chrome of its own — the buttons are
   standalone pills floating over the canvas, never buttons trapped inside
   another button. (The cluster's layout lives in style.css; this is the
   module-scoped safety net.) */
#builderBar,
.builder-bar,
.builder-controls,
.builder-controls {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  border-radius: 0 !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
}
#builderBar[hidden],
.builder-bar[hidden],
.builder-controls[hidden],
.builder-controls[hidden] { display: none !important; }

/* Builder status feedback in the bar */
.builder-hint-ok { color: var(--ok, #2e7d32); font-weight: 600; }
.builder-hint-no { color: var(--err); font-weight: 600; }

/* ── Builder quiz: table of contents + lesson ── */
.sq-group {
  margin: 16px 0 4px;
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--muted);
}
.sq-group:first-child { margin-top: 4px; }

/* The concept text sits directly on the explain pane: no nested card, no
   left accent bar, no tag badge — just the explanation, on the surface.
   The pane scrolls as one (see .sq-lesson-body), so this block never
   scrolls on its own and never clips its last line. */
.sq-rule {
  display: block;
  flex: 0 0 auto;
  height: auto;
  margin: 0;
  border: none !important;
  background: transparent !important;
  box-shadow: none !important;
  padding: 0 !important;
}
.sq-concept,
.sq-rule-content {
  padding: 0;
  height: auto;
  max-height: none;
  overflow: visible;
  box-sizing: border-box;
  font-size: 15px;
  line-height: 1.7;
  color: var(--muted);
}
/* The two sections of the in-depth explanation: the constituency rule and
   the breakdown that follows it. */
.sq-concept-heading {
  margin: 0 0 8px;
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.07em;
}
.sq-concept-heading + .sq-rule-detail { margin-top: 0; }
.sq-concept .sq-rule-detail { margin-top: 10px; }
.sq-concept .sq-rule-text + .sq-concept-heading { margin-top: 22px; }
.sq-rule-text { margin: 0; font-size: 15px; line-height: 1.7; color: var(--ink); font-weight: 600; }
.sq-rule-detail { margin: 10px 0 0; font-size: 15px; line-height: 1.7; color: var(--muted); }

/* The concept's Components list (module-style lessons, e.g. verb phrase):
   term + description pairs under the shared group label. */
.sq-components { margin-top: 16px; }
.sq-component-list { margin: 0; }
.sq-component-list dt {
  margin-top: 10px;
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
}
.sq-component-list dt:first-child { margin-top: 0; }
.sq-component-list dd {
  margin: 2px 0 0;
  font-size: 13px;
  line-height: 1.6;
  color: var(--muted);
}

/* Step-by-step tree-building guide for the active example — flat on the
   pane surface, like the concept text. */
.sq-steps-box {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}
/* Intro line under a node's controls (e.g. the Steps & Practice hint) */
.sq-hint {
  margin: 0 0 8px;
  font-size: 13px;
  line-height: 1.55;
  color: var(--muted);
}
.sq-hint:last-child { margin-bottom: 0; }

/* Active row in the Practice page's example list */
.sq-challenge.is-active {
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 9%, transparent);
}

/* ------------------------------------------------------------------ */
/* Lessons overlay — a solid, light e-learning catalog popup           */
/* ------------------------------------------------------------------ */
.lessons-overlay {
  position: fixed;
  top: 0;
  /* Starts right of the docked rail (0 on mobile, where the drawer is closed). */
  left: var(--rail-w, 0px);
  right: 0;
  bottom: 0;
  z-index: 190;
  display: flex;
  align-items: center;
  justify-content: center;
  /* Flush at the top, so the page header lines up with the other views. */
  padding: 0;
  margin: 0;
  overflow: hidden;
  /* The same surface as the leaderboard and the achievements — no dark
     scrim, no muddy grey in light mode. */
  background: var(--bg);
  color: var(--text);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--dur) var(--ease), visibility 0s linear var(--dur);
}
.lessons-overlay.open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: opacity var(--dur) var(--ease);
}

.lessons-sheet {
  width: min(1600px, 100%);
  height: 100%;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateY(8px);
  transition: transform var(--dur) var(--ease);
}
.lessons-overlay.open .lessons-sheet { transform: none; }

/* Catalog toolbar: the category expander on the left, the completion
   counter on the right — the same row as the achievements toolbar. */
/* E-learning hero band: a course-library title block with a close button. */









/* E-learning catalog header: a course-style title block on the left and the
   category filter + completion counter sitting under it. The toolbar below
   carries the completion summary pinned to the right. */
.sq-catalog-toolbar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
  min-width: 0;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--border);
}

/* The category selector: a compact trigger pill that grows into a
   horizontal row of category pills, inline with the toolbar. */
.sq-cat {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}
.cat-trigger {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 15px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.cat-trigger:hover {
  background: var(--surface-hover, rgba(255, 255, 255, 0.04));
  border-color: var(--border-hover, var(--border));
}
.cat-trigger:active { transform: scale(0.97); }
.cat-trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.cat-trigger-label { white-space: nowrap; }
.cat-chevron {
  display: inline-flex;
  align-items: center;
  transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  flex-shrink: 0;
}
/* Open: the right-pointing chevron turns a quarter turn to point down. */
.sq-cat.is-open .cat-chevron { transform: rotate(90deg); }

/* The row of category pills grows out of the trigger: max-width drives the
   expansion, opacity fades the pills in. While it is collapsed the row is
   hidden from pointer and keyboard focus (after the collapse finishes). */
.cat-options {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  overflow: hidden;
  max-width: 0;
  opacity: 0;
  visibility: hidden;
  transition: max-width 240ms cubic-bezier(0.22, 1, 0.36, 1),
              opacity 200ms ease,
              visibility 0s linear 240ms;
}
.sq-cat.is-open .cat-options {
  max-width: 600px;
  opacity: 1;
  visibility: visible;
  transition: max-width 240ms cubic-bezier(0.22, 1, 0.36, 1),
              opacity 200ms ease,
              visibility 0s linear 0s;
}
.cat-pill {
  flex: 0 0 auto;
  padding: 8px 15px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface);
  color: var(--muted);
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
}
.cat-pill:hover {
  background: var(--surface-hover, rgba(255, 255, 255, 0.04));
  color: var(--text);
}
.cat-pill.is-active {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

/* The catalog frame: the page that scrolls. The header and the content body
   sit inside it, exactly as in the leaderboard and the achievements. */
.lessons-main {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow-y: auto;
}
.lessons-summary {
  margin: 0;
  flex: 0 0 auto;
  font-size: 14px;
  color: var(--muted);
  white-space: nowrap;
}

/* Every lessons wrapper sits on the same surface as the other views. */
#lessonsOverlay,
.sq-catalog-container,
.sq-catalog-content {
  background: var(--bg) !important;
  color: var(--text) !important;
}

/* The card grid fills the whole overlay width — no category rail beside it —
   in three columns, like the achievements grid. */
.sq-catalog-grid {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  width: 100%;
  box-sizing: border-box;
  align-content: start;
}

.sq-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0;
  min-height: 180px;
  width: 100%;
  box-sizing: border-box;
  padding: 24px 26px;
  overflow: hidden;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  color: var(--ink);
  font: inherit;
  text-align: left;
  cursor: pointer;
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}
.sq-card:hover {
  transform: translateY(-2px);
  border-color: var(--accent);
  box-shadow: var(--shadow-md);
}
.sq-card:active { transform: translateY(0); }
.sq-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* Header band: a flat module nameplate strip across the top of the tile. */

.sq-card-title {
  margin: 0;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--text);
  line-height: 1.2;
}
.sq-card-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 3px 8px;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  border-radius: 999px;
  background: var(--accent-soft, rgba(99, 102, 241, 0.12));
  color: var(--accent-strong, #818cf8);
  border: 1px solid var(--accent-border, rgba(99, 102, 241, 0.25));
  text-transform: uppercase;
  letter-spacing: 0.04em;
  flex-shrink: 0;
}

/* Body: the description and the sub-topic preview chips. */

.sq-card-overview {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
  margin-top: 8px;
  font-size: 14px;
  line-height: 1.55;
  color: var(--muted);
}
.sq-card.is-complete .sq-card-bar-fill { background: var(--ok); }
.sq-card-bar-fill {
  display: block;
  height: 100%;
  width: 0;
  background: var(--accent);
  transition: width var(--dur) var(--ease);
}
.sq-card-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4px;
  background: color-mix(in srgb, var(--border) 70%, transparent);
}
.sq-card-count {
  margin-top: auto;
  font-size: 14px;
  font-weight: 600;
  color: var(--muted);
}
.sq-card-title-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}
.sq-card-topics {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.sq-card-topic-chip {
  padding: 3px 9px;
  border-radius: 4px;
  border: 1px solid var(--border);
  background: var(--surface);
  font-size: 11.5px;
  font-weight: 600;
  color: var(--muted);
}

/* ------------------------------------------------------------------ */
/* E-learning catalog: a module cell that expands to its sub-topics.   */
/* ------------------------------------------------------------------ */
.sq-card-cell {
  display: flex;
  flex-direction: column;
  align-self: stretch;
  width: 100%;
  box-sizing: border-box;
}
/* The face fills the cell, so the cards of a row share one height. */
.sq-card-cell > .sq-card { flex: 1 1 auto; }

/* The expand chevron sits at the trailing edge of the module header band. */
.sq-card-expand {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  margin-left: auto;
  color: var(--muted);
  transition: transform 200ms ease, color 200ms ease;
}
.sq-card-expand.is-open { transform: rotate(180deg); color: var(--accent-strong); }

/* The sub-topic list revealed under an expanded module card. */
.sq-module-topics {
  list-style: none;
  margin: 8px 0 0;
  padding: 8px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  background: color-mix(in srgb, var(--panel) 55%, var(--bg));
  border: 1px solid var(--border);
  border-radius: 8px;
  box-shadow: var(--shadow-sm);
}
.sq-module-topic-item { margin: 0; }
.sq-module-topic {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 100%;
  box-sizing: border-box;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--panel);
  color: var(--ink);
  font: inherit;
  text-align: left;
  cursor: pointer;
  transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
}
.sq-module-topic:hover {
  border-color: var(--accent);
  background: var(--accent-soft);
  transform: translateX(2px);
}
.sq-module-topic:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.sq-module-topic-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10px;
}
.sq-module-topic-name { font-size: 14px; font-weight: 700; color: var(--ink); }
.sq-module-topic-count { flex: 0 0 auto; font-size: 12px; font-weight: 600; color: var(--muted); }
.sq-module-topic.is-done .sq-module-topic-count { color: var(--ok); }
.sq-module-topic.is-done .sq-module-topic-name { color: var(--ok); }
.sq-module-topic-detail {
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--muted);
}

/* A gated lesson a guest cannot open yet: the padlock badge says so, and
   picking the card asks for an account instead of opening the lesson. */
.sq-card.is-locked {
  position: relative;
  cursor: pointer;
}
.sq-card-lock-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  margin-left: auto;
  transition: color var(--dur) var(--ease);
}
.sq-card.is-locked:hover {
  border-color: var(--accent-border, rgba(99, 102, 241, 0.35));
}
.sq-card.is-locked:hover .sq-card-lock-badge {
  color: var(--accent);
}

/* ------------------------------------------------------------------ */
/* Active lesson — controls in #quizQuestHost, page in #lessonGuideHost */
/* ------------------------------------------------------------------ */

/* The header row every stage shares: the book button and the lesson title
   on the left, the stage stepper on the right. The row spans the panel's
   content width, so the stepper keeps its distance from the edge. */
.panel-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  margin-bottom: 16px;
  flex-shrink: 0;
}
.panel-title-group {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}
/* The book button is a plain icon: no box, no border, no fill. */
.panel-book-btn {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
  color: var(--text-muted);
  transition: color 0.15s ease;
}
.panel-book-icon {
  flex: 0 0 auto;
  display: block;
  color: currentColor;
}
.panel-book-btn:hover { color: var(--accent-strong); }
.panel-book-btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 9px;
}
.lesson-panel-title {
  margin: 0;
  min-width: 0;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.01em;
  line-height: 1.25;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* The left canvas panel of the Lessons workspace: the same surface, radius
   and border as the Syntax Generator's canvas. One token for both, so the
   two workspaces cannot drift apart. */
.lesson-canvas-panel {
  height: 100%;
  min-height: 0;
  border-radius: var(--panel-radius);
  border: 1px solid var(--border);
  background: var(--surface);
  position: relative;
  overflow: hidden;
}

/* --------------------------------------------------------------------------
   The right rail of a lesson
   -------------------------------------------------------------------------- */
/* Two dedicated surfaces with a fixed split: the upper one belongs to the
   learner (the controls, the active step, the question, the action), the
   lower one to the grammar (the theory, the breakdown, the diagnostics). The
   split never moves, so the dividing line does not bounce between stages. */
body.lesson-view .lesson-right-column {
  display: grid;
  grid-template-rows: minmax(290px, 42%) 1fr;
  gap: var(--workspace-gap, 12px);
  height: 100%;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}
body.lesson-view .panel-upper-right,
body.lesson-view .panel-lower-right {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--panel-radius, 12px);
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
}
body.lesson-view .panel-upper-right {
  padding: 20px 24px;
  justify-content: space-between;
}
body.lesson-view .panel-lower-right {
  padding: 20px 24px;
  overflow-y: auto;
  /* The analysis is long: it scrolls smoothly, never in jerks. */
  scroll-behavior: smooth;
}
/* The split is fixed in a lesson, so the row handle has nothing to drag. */
body.lesson-view #rowResizer { display: none; }

/* The lesson fills its panel, and the stage content takes the room the
   header and the pinned action leave. */
.sq-lesson {
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
/* The primary action sits at the bottom of the panel, at the same baseline in
   every stage. */
.panel-upper-right .quiz-primary-btn { margin-top: auto; }

/* The stage content of the upper-right pane. */
.sq-lesson-stage {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
}

/* The Concept stage's overview: where the construction sits, the structure
   it follows, and the one thing to take away. It renders straight on the
   panel surface — no card around it, no border, no divider — so the panel
   reads as one continuous piece of typography. */
.sq-lesson-overview {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 0;
  border: none;
  background: none;
}
.sq-overview-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}
.sq-overview-tag {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border: none;
  border-radius: 999px;
  background: var(--border);
  color: var(--text-muted);
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.sq-overview-tag.is-type {
}
.sq-overview-structure {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
.sq-overview-label {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
}
.sq-overview-formula {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--text);
  word-break: break-word;
}
.sq-overview-goal {
  margin: 0;
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-muted);
}
/* The full-width action: the button's own 4px inset has to be part of its
   width, or it overflows the panel by 4px and draws a stray scrollbar. */
.sq-lesson-cta { width: calc(100% - 8px); }

/* The sentence currently on the canvas — and the quiz prompt. Both render
   straight on the panel surface: no wrapper card, no left accent bar. */
.sq-active-sentence {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 0;
  border: none;
  background: none;
}
.sq-active-label {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--accent-strong);
  color: var(--text-muted);
}
/* The quiz badge: a small, quiet marker of where the learner is. */
.sq-active-label.is-quiz {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--accent);
}
.sq-active-text {
  margin: 0;
  margin-top: 6px;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.4;
  color: var(--text);
}

/* The example switcher: one segmented bar, one tab per example. The tab
   carries the number and the sentence, so the learner knows what each one
   opens; a built example keeps a green checkmark. */
.example-pill-selector {
/* Section picker (module-style lessons): one pill per section/type. */
.sq-section-picker { display: flex; flex-wrap: wrap; gap: 6px; }
.sq-section-pill {
  flex: 0 0 auto;
  padding: 7px 12px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface);
  color: var(--muted);
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
}
.sq-section-pill:hover { border-color: var(--accent); color: var(--accent-strong); }
.sq-section-pill.is-active { background: var(--accent); border-color: var(--accent); color: #fff; }
.sq-section-pill.is-done { border-color: color-mix(in srgb, var(--success) 55%, var(--border)); color: var(--success); }
.sq-section-pill.is-active.is-done { background: var(--accent); border-color: var(--accent); color: #fff; }

/* The active section's panel on the Practice page: title, built counter,
   description, and its clickable example sentences. */
.sq-section-panel {
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
}
.sq-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10px;
}
.sq-section-title { margin: 0; font-size: 14px; font-weight: 700; color: var(--ink); }
.sq-section-count { flex: 0 0 auto; font-size: 12px; font-weight: 600; color: var(--muted); }
.sq-section-detail { margin: 8px 0 0; font-size: 13px; line-height: 1.6; color: var(--muted); }
.sq-section-panel .sq-quiz-list { margin-top: 10px; }
.sq-quiz-sent-btn {
  min-width: 0;
  padding: 0;
  border: none;
  background: none;
  font: inherit;
  font-size: 13px;
  color: var(--ink);
  text-align: left;
  cursor: pointer;
  border-radius: 4px;
  transition: color var(--dur-fast) var(--ease);
}
.sq-quiz-sent-btn:hover { color: var(--accent-strong); text-decoration: underline; }

  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  min-width: 0;
}
.example-tab {
  display: inline-flex;
  align-items: baseline;
  gap: 5px;
  min-width: 0;
  max-width: 100%;
  padding: 6px 12px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--bg);
  color: var(--text-muted);
  font: inherit;
  font-size: 13px;
  text-align: left;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease),
    border-color var(--dur-fast) var(--ease);
}
.example-tab:hover { border-color: var(--accent-border, var(--accent)); color: var(--text); }
.example-tab-text {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.example-tab.active {
  background: var(--accent-soft);
  border-color: var(--accent-border, var(--accent));
  color: var(--text);
  font-weight: 700;
}
.example-tab-check {
  flex: 0 0 auto;
  font-size: 11.5px;
  font-weight: 800;
  color: var(--success, #22c55e);
}

/* The active step (upper-right pane): what to do right now. Only this one
   step is shown, so it can be read at a comfortable size. */
.sq-active-step { display: flex; flex-direction: column; gap: 8px; }
.sq-active-step-title {
  margin: 0;
  font-size: 17px;
  font-weight: 800;
  line-height: 1.3;
  color: var(--ink);
}
.sq-active-step-text {
  margin: 0;
  font-size: 16px;
  line-height: 1.65;
  color: var(--ink);
}
/* The rule in play: a label and the formula, straight on the surface. */
.sq-active-step-rule {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-top: 4px;
  padding: 0;
  border: none;
  background: none;
}

/* The step pager: ← Step X of Y →. */
.sq-step-pager {
  flex: 1 1 auto;
  min-width: 0;
  display: grid;
  grid-template-columns: 32px 1fr 32px;
  align-items: center;
  gap: 8px;
}
.sq-step-pager-label {
  text-align: center;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--muted);
}
.sq-step-btn {
  width: 32px;
  height: 32px;
  padding: 0;
  display: grid;
  place-items: center;
  font-size: 14px;
}
.sq-step-btn:disabled { opacity: .45; cursor: not-allowed; }

/* The quiz stage: the score, the live validation status, and the way on. */
.sq-quiz-score { display: flex; align-items: baseline; gap: 6px; margin-top: 2px; }
.sq-quiz-score-value { font-size: 18px; font-weight: 800; color: var(--accent-strong); }
.sq-quiz-score-label { font-size: 12px; font-weight: 600; color: var(--text-muted); }
.sq-lesson-nav { flex: 0 0 auto; display: flex; gap: 8px; }
.sq-lesson-nav .sq-ghost { margin: 0; flex: 0 0 auto; }
.sq-lesson-nav .sq-primary { margin: 0; flex: 1 1 auto; }
.sq-lesson-nav .sq-ghost:disabled { opacity: .45; cursor: not-allowed; }
.sq-lesson-nav .sq-ghost, .sq-lesson-nav .sq-primary { padding: 9px 12px; font-size: 12.5px; }

.sq-lesson-body .sq-group { margin: 0; }

/* The analysis panel's content: the panel itself is the scroll container, so
   long explanations are never clipped and the panel keeps one clean scroll
   bar instead of two. */
.sq-lesson-body {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* --------------------------------------------------------------------------
   The analysis panel: the grammar's side of the lesson
   -------------------------------------------------------------------------- */
/* The one crisp section header every analysis panel opens with. */
.analysis-section-label {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: var(--text-muted);
}
/* A note that stands in for content that is still on its way. */
.sq-panel-empty {
  margin: 0;
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-muted);
}

/* The breakdown of the example on the canvas: the leaves with their POS
   tags, the head of the phrase, and the modifiers around it. */
.sq-breakdown {
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-width: 0;
}
/* The leaves, one by one, with the tag SynTutor gave them. */
.syntax-token-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.syntax-token {
  display: inline-flex;
  align-items: baseline;
  gap: 5px;
  padding: 4px 10px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--bg);
}
.syntax-token-word { font-size: 13.5px; font-weight: 700; color: var(--text); }
.syntax-token-tag {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  font-size: 11px;
  font-weight: 700;
  color: var(--accent-strong);
}
/* The structural roles of the example, as a clean key-value grid. */
.syntax-role-grid {
  display: grid;
  grid-template-columns: 140px 1fr;
  gap: 8px 16px;
  margin: 14px 0;
  font-size: 13px;
}
.syntax-role-label {
  color: var(--text-muted);
  font-weight: 700;
  font-size: 11px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.syntax-role-value {
  color: var(--text);
  font-weight: 600;
  line-height: 1.6;
}
.syntax-explanation {
  margin: 0;
  font-size: 14px;
  line-height: 1.65;
  color: var(--muted);
}

/* The monospace rule badge that closes an analysis panel. */
.rule-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  align-self: flex-start;
  max-width: 100%;
  padding: 6px 12px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--bg);
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
}
.rule-chip-label { white-space: nowrap; }
.rule-chip-code {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* The diagnostics of the quiz stage: the rule the learner is building to,
   and — once they check — the verdict on the tree they built. */
.sq-diagnostics {
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-width: 0;
}
.sq-diag-block {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

/* Before the first check: the target rule and the way to reach it. */
.validation-guidelines-card,
.validation-result-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 16px 18px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--bg);
}
.validation-card-label {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
}
.validation-rule {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  font-size: 17px;
  font-weight: 700;
  color: var(--text);
  word-break: break-word;
}
.validation-instructions {
  margin: 0;
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--text-muted);
}
/* The verdict of a check: green when the constituency is valid, red when it
   is not. */
.validation-result-card.is-ok {
  background: color-mix(in srgb, var(--success, #22c55e) 10%, transparent);
  border-color: color-mix(in srgb, var(--success, #22c55e) 32%, transparent);
}
.validation-result-card.is-no {
  background: color-mix(in srgb, var(--err) 9%, transparent);
  border-color: color-mix(in srgb, var(--err) 30%, transparent);
}
.validation-card-title {
  font-size: 14.5px;
  font-weight: 800;
  line-height: 1.4;
}
.validation-result-card.is-ok .validation-card-title { color: var(--success, #22c55e); }
.validation-result-card.is-no .validation-card-title { color: var(--err); }
.validation-card-body {
  margin: 0;
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--text);
}
/* What to fix: the findings, one per line. */
.validation-findings {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.validation-finding {
  margin: 0;
  padding-left: 12px;
  border-left: 2px solid var(--border);
  font-size: 13px;
  line-height: 1.55;
  color: var(--muted);
}

/* Node-and-branch progress: three compact nodes (1 — 2 — 3) joined by short
   branch lines. Each node is a clickable stage marker: the active one is
   accented, a finished one carries a green ✓. The nodes and the lines
   between them are deliberately high-contrast — they are the learner's
   position in the lesson. */
.stage-stepper-tracker {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  flex-shrink: 0;
  gap: 0;
}
.sq-progress-node {
  flex: 0 0 auto;
  width: 28px;
  height: 28px;
  padding: 0;
  /* The quieter stage markers need a visible ring of their own — the
     subtle border token keeps them from fading into the panel. */
  border: 1px solid var(--border-subtle, var(--border));
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  color: var(--text-muted);
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  line-height: 1;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.sq-progress-node:hover { border-color: var(--accent); color: var(--accent-strong); }
.sq-progress-node.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  box-shadow: 0 0 0 3px var(--accent-soft);
}
.sq-progress-node.completed {
  background: var(--success, #22c55e);
  border-color: var(--success, #22c55e);
  color: #fff;
}
.sq-progress-node-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 13px;
  font-weight: 700;
  line-height: 1;
}
.sq-progress-line {
  flex: 0 0 auto;
  /* Centred on the node badges, never riding their edge. */
  align-self: center;
  width: 24px;
  height: 2px;
  background: var(--border-subtle, rgba(255, 255, 255, 0.15));
}

/* ------------------------------------------------------------------ */
/* The Concept stage's canvas                                           */
/* ------------------------------------------------------------------ */
/* Fallback for the reference tree: when SynTutor's model cannot be reached,
   the canvas shows a clean, centred summary of the structure instead of a
   distorted tree (or an empty canvas). */
.lesson-canvas-note {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 24px;
  text-align: center;
  pointer-events: none;
}
.lesson-canvas-note[hidden] { display: none; }
.lesson-canvas-label {
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
}
.lesson-canvas-formula {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  font-size: 26px;
  font-weight: 700;
}
.lesson-canvas-example {
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
}
.lesson-canvas-hint {
  font-size: 12.5px;
  color: var(--text-muted);
}

/* ------------------------------------------------------------------ */
/* Lesson quiz page — the module's only quiz, at the very end          */
/* ------------------------------------------------------------------ */
/* The module quiz briefing — flat on the pane surface, like the concept. */
.sq-quiz-summary {
  padding: 0;
  border: none;
  background: transparent;
}
.sq-quiz-summary p { margin: 0; font-size: 13px; line-height: 1.55; }
.sq-quiz-list { display: flex; flex-direction: column; gap: 4px; margin: 0; padding: 0; list-style: none; }
.sq-quiz-item {
  display: flex;
  align-items: baseline;
  gap: 8px;
  padding: 5px 0;
  font-size: 13px;
  color: var(--ink);
}
.sq-quiz-mark { flex: 0 0 auto; font-weight: 800; color: var(--muted); }
.sq-quiz-mark.is-done { color: var(--ok); }
.sq-quiz-sent { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ------------------------------------------------------------------ */
/* Interactive step guide — spotlight ring over the canvas             */
/* ------------------------------------------------------------------ */
/* A pointer-events: none layer holding only the spotlight ring. The step
   itself is spelled out in the upper-right panel, so the canvas keeps
   nothing but the learner's tree. The layer sits above the canvas/pane
   chrome but below the right-click menu (z 60), the sidebar rail (z 195),
   the lessons overlay (z 190) and modals (z 300). */
.step-guide {
  position: fixed;
  inset: 0;
  z-index: 29;
  pointer-events: none;
}
.step-guide[hidden] { display: none; }
.step-guide-ring {
  position: fixed;
  border: 2px solid var(--accent);
  border-radius: 10px;
  box-shadow:
    0 0 0 9999px rgba(15, 17, 23, 0.3),
    0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
}
[data-theme="dark"] .step-guide-ring {
  box-shadow:
    0 0 0 9999px rgba(4, 6, 12, 0.45),
    0 0 0 3px color-mix(in srgb, var(--accent) 24%, transparent);
}

/* Narrow screens keep three columns unless there is height for a third row */
@media (max-width: 1020px) {
  .sq-card-overview { -webkit-line-clamp: 3; }
  .sq-catalog-grid { grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); }
}
@media (max-width: 760px) {
  .sq-catalog-grid { grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); }
  .sq-card { min-height: 0; }
  .sq-card-overview { -webkit-line-clamp: 2; }
  /* The toolbar stacks: the expander on top, the counter underneath. */
  .sq-catalog-toolbar { flex-direction: column; align-items: flex-start; gap: 10px; }
  .lessons-summary { white-space: normal; }
}
@media (max-width: 520px) {
  .lessons-overlay { padding: 10px; }
  .sq-catalog-grid { grid-template-columns: minmax(0, 1fr); }
  .cat-pill { padding: 6px 12px; font-size: 11.5px; }
  .sq-card-title { font-size: 18px; }
}
@media (max-height: 620px) {
  .lessons-overlay { padding: 10px 14px; }
  .lessons-sheet { gap: 10px; }
  .sq-card { min-height: 140px; padding: 12px 14px 14px; }
  .sq-card-title { font-size: 18px; }
  .sq-card-overview { -webkit-line-clamp: 2; }
}

/* ------------------------------------------------------------------ */
/* Module lesson (Verb phrase): LMS-style read-only lesson panel       */
/* ------------------------------------------------------------------ */
.sq-module {
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-height: 0;
  padding-bottom: 6px;
}
/* The model tree is read-only: it must not advertise a grab/drag affordance. */
body.lesson-model #treeCanvas,
body.lesson-model #treeCanvas:hover,
body.lesson-model #treeCanvas:active { cursor: default; }
.sq-module .sq-lesson-head { margin-bottom: 0; }

/* Subtype navigation */
.sq-module-nav { min-width: 0; }
.sq-module-pills { display: flex; flex-wrap: wrap; gap: 6px; }
.sq-module-pills .sq-section-pill { padding: 6px 11px; font-size: 11.5px; }
.sq-module-pills .sq-section-pill:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* Subtype overview: title, static definition, and the live sentence explanation */
.sq-module-overview,
.sq-module-samples {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
  min-width: 0;
}
.sq-module-eyebrow {
  margin: 0;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-strong);
}
.sq-module-title {
  margin: 0;
  font-size: 17px;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.sq-module-definition {
  margin: 0;
  font-size: 13px;
  line-height: 1.6;
  color: var(--muted);
}

/* The live explanation sits directly under the subtype definition as text. */
.sq-module-explanation {
  margin: 2px 0 0;
  font-size: 13px;
  line-height: 1.65;
  color: var(--ink);
}
.sq-module-explanation.is-status {
  color: var(--muted);
}
.sq-module-explanation.is-error {
  color: var(--err);
  font-weight: 600;
}

/* Verb phrase structural formula: bold label above the neat formula text,
   no special box. Acronyms show a hover tooltip spelling out what they are. */
.sq-module-formula { margin: 10px 0 8px; }
.sq-module-formula-label {
  display: block;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-strong);
  margin-bottom: 4px;
}
.sq-module-formula-text {
  display: inline-block;
  font-size: 14px;
  font-weight: 800;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  letter-spacing: 0.04em;
  color: var(--ink);
  line-height: 1.5;
}
/* Acronym hover tooltip (pop-up on hover, not a box around the formula). */
.sq-acronym {
  position: relative;
  display: inline-block;
  border-bottom: 1px dotted var(--border);
  cursor: help;
  text-decoration: none;
}
.sq-acronym::after {
  content: attr(data-term);
  position: fixed;
  left: var(--ac-tooltip-left, 0);
  top: var(--ac-tooltip-top, 0);
  transform: translatex(-50%) translatey(-100%);
  padding: 6px 10px;
  font-size: 12px;
  font-weight: 700;
  color: #f8fafc;
  background: #0f172a;
  border: 1px solid #334155;
  border-radius: 5px;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.12s ease, transform 0.12s ease;
  z-index: 10000;
}
.sq-acronym::before {
  content: '';
  position: fixed;
  left: var(--ac-tooltip-left, 0);
  top: var(--ac-tooltip-top, 0);
  transform: translatex(-50%) translatey(0);
  border: 6px solid transparent;
  border-top-color: #0f172a;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.12s ease, transform 0.12s ease;
  z-index: 10000;
}
.sq-acronym:hover::after,
.sq-acronym:hover::before {
  opacity: 1;
}
.sq-acronym:hover::after { transform: translatex(-50%) translatey(calc(-100% - 2px)); }
.sq-acronym:hover::before { transform: translatex(-50%) translatey(2px); }

/* Sample sentences: a clean selectable list, no numbering and no Try CTA. */
.sq-module-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10px;
  min-width: 0;
}
.sq-module-section-title {
  margin: 0;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted);
}
.sq-module-section-count {
  flex: 0 0 auto;
  font-size: 11px;
  font-weight: 700;
  color: var(--muted);
}
.sq-sample-list {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.sq-sample-item { margin: 0; }
.sq-sample-button {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-width: 0;
  padding: 10px 11px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  font: inherit;
  text-align: left;
  color: var(--ink);
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.sq-sample-button:hover { background: var(--accent-soft); }
.sq-sample-button.is-active {
  border-color: color-mix(in srgb, var(--accent) 28%, var(--border));
  background: var(--accent-soft);
  color: var(--ink);
}
.sq-sample-button.is-active .sq-sample-text { font-weight: 600; }
.sq-sample-button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.sq-sample-text {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 13px;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.sq-sample-chevron {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  color: var(--muted);
  opacity: 0.7;
}
.sq-sample-button.is-active .sq-sample-chevron { color: var(--accent-strong); opacity: 1; }

@media (max-width: 520px) {
  .sq-module-pills {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 2px;
    scrollbar-width: thin;
  }
  .sq-module-pills .sq-section-pill { flex: 0 0 auto; }
  .sq-module-overview,
  .sq-module-samples { padding: 14px; }
}

@media (prefers-reduced-motion: reduce) {
  .sq-sample-button,
  .sq-module-pills .sq-section-pill { transition: none; }
}
