    ('RB', 'Adverb', 'quickly, very, not'),
    ('RBR', 'Adverb, comparative', 'quicker, more'),
    ('RBS', 'Adverb, superlative', 'quickest, most'),
    ('RP', 'Particle', 'up (give up), off (turn off)'),
