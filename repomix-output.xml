    ('NNPS', 'Proper noun, plural', 'Americans, Beatles'),
    ('PDT', 'Predeterminer', 'all the, both the'),
    ('POS', 'Possessive ending', "John's, the cat's"),
    ('PRP', 'Personal pronoun', 'I, he, she, it, they'),
