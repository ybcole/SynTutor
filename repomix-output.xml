    ('JJS', 'Adjective, superlative', 'quickest, happiest'),
    ('LS', 'List item marker', '1., A.'),
    ('MD', 'Modal', 'can, will, must, should'),
    ('NN', 'Noun, singular / mass', 'cat, water, idea'),
