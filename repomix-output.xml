/* ------------------------------------------------------------------ */
/* Left navigation rail (docked) / drawer (mobile)                    */
/*                                                                     */
/* Desktop: #appSidebar is docked in the shell's first grid column as a */
/* ChatGPT-style rail — a 60px icon column by default, 248px with      */
/* .expanded, toggled only by #sidebarToggleBtn (never on hover). The  */
/* #appSidebar backdrop stops being a fixed overlay and becomes the    */
/* plain grid wrapper, so the .active toggles tree-quiz.js still        */
/* performs are harmless no-ops. On small screens (≤760px) the         */
/* original slide-over drawer behaviour is kept, opened with           */
/* #mobileNavBtn; it sits below the left sub-panels (z 210) so those   */
/* stay reachable while the drawer is open.                            */
/* ------------------------------------------------------------------ */
.app-sidebar-backdrop {
  position: fixed;
  inset: 0;
  z-index: 197;
  display: flex;
  justify-content: flex-start;
  background: rgba(20, 16, 36, 0.4);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--dur) var(--ease), visibility var(--dur) var(--ease);
}
.app-sidebar-backdrop.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}
.app-sidebar {
  display: flex;
  flex-direction: column;
  width: 60px; /* collapsed icon rail */
  height: 100%;
  padding: 14px 8px 10px;
  background: var(--panel);
  border-right: 1px solid var(--border);
  min-width: 0;
  /* Persistent rail: above the Lessons overlay (190) and the mobile
     drawer backdrop (197), below the left sub-panels (210) and the
     auth modal (300). */
  position: relative;
  z-index: 195;
  transition: width var(--dur) var(--ease);
}
.app-sidebar.expanded { width: 248px; padding: 14px 12px 10px; }

@media (min-width: 761px) {
  .app-sidebar-backdrop {
    position: static;
    inset: auto;
    z-index: auto;
    display: flex;
    justify-content: flex-start;
    background: transparent;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: none;
    grid-column: 1;
    grid-row: 1 / -1;
  }
  /* Icon rail: labels and the account name appear with .expanded only. */
  .app-sidebar:not(.expanded) .sidebar-item { justify-content: center; padding: 11px 0; gap: 0; }
  .app-sidebar:not(.expanded) .sidebar-item span,
  .app-sidebar:not(.expanded) .brand-title,
  .app-sidebar:not(.expanded) #identityLabel { display: none; }
  .app-sidebar:not(.expanded) .sidebar-brand { justify-content: center; padding: 6px 2px; }
  .app-sidebar:not(.expanded) .app-sidebar-foot .menu-btn { justify-content: center; padding: 7px 0; }
  .app-sidebar:not(.expanded) .profile-anchor { justify-content: center; }
  .app-sidebar:not(.expanded) .identity-chip { padding: 4px; }
  /* Collapsed top zone stacks: the monogram sits centered over the
     expand toggle, which stays visible at every width. */
  .app-sidebar:not(.expanded) .app-sidebar-top {
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  /* The .sidebar-close selector out-ranks the later .drawer-close base
     rule that would otherwise re-show it. */
  .app-sidebar .sidebar-close { display: none; }
}

@media (max-width: 760px) {
  .app-sidebar,
  .app-sidebar.expanded {
    width: min(280px, 82vw);
    padding: 18px 14px 10px;
    transform: translateX(-100%);
    box-shadow: 8px 0 24px rgba(0, 0, 0, 0.15);
    border-right: none;
    transition: transform var(--dur) var(--ease), width var(--dur) var(--ease);
  }
  .app-sidebar-backdrop.active .app-sidebar {
    transform: translateX(0);
  }
  .sidebar-toggle { display: none; }
}

/* Top zone: brand mark + expand/collapse toggle (+ mobile drawer close) */
.app-sidebar-top {
  display: flex;
