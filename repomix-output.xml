:root {
  --bg: #f5f6f8;
  --panel: #ffffff;
  --surface: #ffffff;
  --ink: #1e2029;
  --muted: #64748b;
  /* Semantic aliases: the lesson chrome names its greys after their role. */
  --text: var(--ink);
  --text-muted: var(--muted);
  --accent-border: rgba(99, 102, 241, 0.25);
  --accent: #6d5ae6;
  --accent-strong: #5946d4;
  --accent-soft: #efeafc;
  --ok: #2e8b57;
  /* Semantic alias for the success colour (completed stages, solved trees). */
  --success: var(--ok);
  --err: #d64545;
  --warn: #c98f00;
  --xp: #d97706;
  --border: #e2e8f0;
  --card-border: #e2e8f0;
  /* Connector lines and other quiet borders: visible, never faint. */
  --border-subtle: #c3cddb;
  --radius: 12px;
  --radius-sm: 8px;
  /* Workspace layout tokens — one gap, one padding and one radius for every
     panel of every workspace. The Syntax Generator and the Lessons rail read
     the same values, so the two can never drift apart. */
  --workspace-padding: 8px;
  --workspace-gap: 8px;
  --panel-radius: 12px;
  --header-bg: #ffffff;
  --header-text: #1e2029;
  --header-border: #e2e8f0;
  --header-hover: rgba(15, 23, 42, 0.06);
