<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SynTutor — Welcome</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232a6f8f'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='18' font-weight='bold' text-anchor='middle' fill='white'%3ES%3C/text%3E%3C/svg%3E" />
  <script>
    (function () {
      const savedTheme = localStorage.getItem('syntutor_theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --bg: #ffffff;
      --ink: #111111;
      --muted: #666666;
      --border: #e2e2e2;
      --divider: #cfcfcf;
      --btn-bg: #000000;
      --btn-text: #ffffff;
      --focus: #6d5ae6;
      --ease: cubic-bezier(0.33, 0.6, 0.4, 1);
      color-scheme: light;
    }

    [data-theme="dark"] {
      --bg: #0f1117;
      --ink: #f8fafc;
      --muted: #94a3b8;
      --border: #2e3442;
      --divider: #334155;
      --btn-bg: #f8fafc;
      --btn-text: #0f1117;
      --focus: #8b7cf1;
      color-scheme: dark;
    }

    button, input, select {
      font-family: inherit;
    }

    button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    :focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    ::selection {
      background: rgba(109, 90, 230, 0.2);
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: var(--ink);
      display: flex;
      flex-direction: column;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .landing-header {
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      border-bottom: 1px solid var(--border);
    }

    .theme-toggle-btn {
      background: none;
      border: none;
      color: var(--ink);
      cursor: pointer;
      padding: 8px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s ease, transform 0.1s ease;
    }
    .theme-toggle-btn:hover {
      background: rgba(128, 128, 128, 0.1);
    }
    .theme-toggle-btn:active {
      transform: scale(0.94);
    }

    .nav-login-btn {
      height: 34px;
      padding: 0 16px;
      background: var(--btn-bg);
      color: var(--btn-text);
      border: none;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: opacity 0.15s ease, transform 0.1s ease;
    }
    .nav-login-btn:hover {
      opacity: 0.85;
    }
    .nav-login-btn:active {
      transform: scale(0.97);
    }

    .landing-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
    }

    .landing-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 520px;
    }

    .brand-title {
      font-size: 82px;
      font-weight: 900;
      color: var(--ink);
      letter-spacing: -1.5px;
      margin: 0;
      line-height: 1;
      text-shadow: 3px 6px 12px rgba(0, 0, 0, 0.15);
    }

    .brand-divider {
      width: 250px;
      height: 1px;
      background: var(--divider);
      margin: 18px auto 22px;
    }

    .subtitle {
      font-size: 18px;
      font-weight: 400;
      color: var(--muted);
      line-height: 1.45;
      margin: 0 0 32px;
      max-width: 440px;
    }

    .enter-guest-btn {
      background: transparent;
      border: none;
      color: var(--ink);
      cursor: pointer;
      font-size: 32px;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      transition: transform 0.15s ease, background 0.15s ease;
      text-decoration: none;
    }
    .enter-guest-btn:hover {
      background: rgba(128, 128, 128, 0.1);
      transform: translateX(4px);
    }
    .enter-guest-btn:active {
      transform: translateX(4px) scale(0.94);
    }

    .auth-form-wrap {
      width: 100%;
      max-width: 320px;
      margin-top: 24px;
      display: none;
    }
    .auth-form-wrap.open {
      display: block;
    }

    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .input-field {
      width: 100%;
      height: 40px;
      padding: 0 2px;
      border: none;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
      font-size: 13.5px;
      background: transparent;
      color: var(--ink);
      outline: none;
      transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
    }
    .input-field::placeholder {
      color: var(--muted);
      opacity: 1;
    }
    .input-field:hover {
      border-bottom-color: color-mix(in srgb, var(--border) 60%, var(--ink));
    }
    .input-field:focus {
      border-bottom-color: var(--focus);
      box-shadow: 0 2px 10px -3px color-mix(in srgb, var(--focus) 55%, transparent);
    }
    .input-field:focus-visible {
