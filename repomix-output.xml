    "10.8": [
      {"bad":"The teacher entered the room. \"Where are you going\" he asked. The pupils pointed to the door. \"The bus is leaving now\" she said. Everyone hurried outside.","good":"The teacher entered the room. \"Where are you going?\" he asked. The pupils pointed to the door. \"The bus is leaving now,\" she said. Everyone hurried outside.","explanation":"Place punctuation inside the quotation marks.","sentences":[{"bad":"The teacher entered the room.","good":"The teacher entered the room."},{"bad":"\"Where are you going\" he asked.","good":"\"Where are you going?\" he asked."},{"bad":"The pupils pointed to the door.","good":"The pupils pointed to the door."},{"bad":"\"The bus is leaving now\" she said.","good":"\"The bus is leaving now,\" she said."},{"bad":"Everyone hurried outside.","good":"Everyone hurried outside."}]},
      {"bad":"The coach gathered the players. \"Listen carefully\" he said. The team fell silent. \"We will win today\" he added. They ran onto the pitch.","good":"The coach gathered the players. \"Listen carefully,\" he said. The team fell silent. \"We will win today,\" he added. They ran onto the pitch.","explanation":"A comma separates speech from the reporting clause.","sentences":[{"bad":"The coach gathered the players.","good":"The coach gathered the players."},{"bad":"\"Listen carefully\" he said.","good":"\"Listen carefully,\" he said."},{"bad":"The team fell silent.","good":"The team fell silent."},{"bad":"\"We will win today\" he added.","good":"\"We will win today,\" he added."},{"bad":"They ran onto the pitch.","good":"They ran onto the pitch."}]},
      {"bad":"The chef greeted the guests. \"Dinner is ready\" she announced. The table was beautifully set. \"Please take your seats\" she added. The meal was delicious.","good":"The chef greeted the guests. \"Dinner is ready,\" she announced. The table was beautifully set. \"Please take your seats,\" she added. The meal was delicious.","explanation":"Put a comma inside the closing quotation mark.","sentences":[{"bad":"The chef greeted the guests.","good":"The chef greeted the guests."},{"bad":"\"Dinner is ready\" she announced.","good":"\"Dinner is ready,\" she announced."},{"bad":"The table was beautifully set.","good":"The table was beautifully set."},{"bad":"\"Please take your seats\" she added.","good":"\"Please take your seats,\" she added."},{"bad":"The meal was delicious.","good":"The meal was delicious."}]},
      {"bad":"The librarian helped a reader. \"The book is over there\" she said. The reader found it quickly. \"It sounds wonderful\" he replied. He borrowed it at once.","good":"The librarian helped a reader. \"The book is over there,\" she said. The reader found it quickly. \"It sounds wonderful,\" he replied. He borrowed it at once.","explanation":"Set off the spoken words with punctuation inside the quotes.","sentences":[{"bad":"The librarian helped a reader.","good":"The librarian helped a reader."},{"bad":"\"The book is over there\" she said.","good":"\"The book is over there,\" she said."},{"bad":"The reader found it quickly.","good":"The reader found it quickly."},{"bad":"\"It sounds wonderful\" he replied.","good":"\"It sounds wonderful,\" he replied."},{"bad":"He borrowed it at once.","good":"He borrowed it at once."}]},
      {"bad":"The guide met the group. \"Follow me please\" she said. The path led through the woods. \"Watch your step here\" she warned. They reached the waterfall safely.","good":"The guide met the group. \"Follow me, please,\" she said. The path led through the woods. \"Watch your step here,\" she warned. They reached the waterfall safely.","explanation":"Punctuate the quotation before the reporting clause.","sentences":[{"bad":"The guide met the group.","good":"The guide met the group."},{"bad":"\"Follow me please\" she said.","good":"\"Follow me, please,\" she said."},{"bad":"The path led through the woods.","good":"The path led through the woods."},{"bad":"\"Watch your step here\" she warned.","good":"\"Watch your step here,\" she warned."},{"bad":"They reached the waterfall safely.","good":"They reached the waterfall safely."}]}
