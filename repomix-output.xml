    "8.6": [
      {"bad":"The children walked to the park. They ran in the playground happily. The gate stood wide open. They climbed on the climbing frame. They played until it grew dark.","good":"The children walked to the park. They ran into the playground happily. The gate stood wide open. They climbed onto the climbing frame. They played until it grew dark.","explanation":"Use \"into\" for entering and \"onto\" for a surface.","sentences":[{"bad":"The children walked to the park.","good":"The children walked to the park."},{"bad":"They ran in the playground happily.","good":"They ran into the playground happily."},{"bad":"The gate stood wide open.","good":"The gate stood wide open."},{"bad":"They climbed on the climbing frame.","good":"They climbed onto the climbing frame."},{"bad":"They played until it grew dark.","good":"They played until it grew dark."}]},
      {"bad":"The family set off on holiday. They drove in the tunnel towards the coast. The road curved along the cliffs. They walked on the beach at sunset. It was a peaceful evening.","good":"The family set off on holiday. They drove through the tunnel towards the coast. The road curved along the cliffs. They walked onto the beach at sunset. It was a peaceful evening.","explanation":"Use \"through\" for passing within, and \"onto\" for a surface.","sentences":[{"bad":"The family set off on holiday.","good":"The family set off on holiday."},{"bad":"They drove in the tunnel towards the coast.","good":"They drove through the tunnel towards the coast."},{"bad":"The road curved along the cliffs.","good":"The road curved along the cliffs."},{"bad":"They walked on the beach at sunset.","good":"They walked onto the beach at sunset."},{"bad":"It was a peaceful evening.","good":"It was a peaceful evening."}]},
      {"bad":"The train crossed the valley. It went in a long tunnel. The view opened up on the far side. The track ran over a wide river. The journey took two hours.","good":"The train crossed the valley. It went through a long tunnel. The view opened up on the far side. The track ran over a wide river. The journey took two hours.","explanation":"Use \"through\" for going within an enclosed space.","sentences":[{"bad":"The train crossed the valley.","good":"The train crossed the valley."},{"bad":"It went in a long tunnel.","good":"It went through a long tunnel."},{"bad":"The view opened up on the far side.","good":"The view opened up on the far side."},{"bad":"The track ran over a wide river.","good":"The track ran over a wide river."},{"bad":"The journey took two hours.","good":"The journey took two hours."}]},
      {"bad":"The hikers left the village early. They climbed on the steep hill. The path was rocky and narrow. They walked along a ridge and down the other side. They reached the valley by noon.","good":"The hikers left the village early. They climbed up the steep hill. The path was rocky and narrow. They walked along a ridge and down the other side. They reached the valley by noon.","explanation":"Use \"up\" and \"down\" for vertical movement.","sentences":[{"bad":"The hikers left the village early.","good":"The hikers left the village early."},{"bad":"They climbed on the steep hill.","good":"They climbed up the steep hill."},{"bad":"The path was rocky and narrow.","good":"The path was rocky and narrow."},{"bad":"They walked along a ridge and down the other side.","good":"They walked along a ridge and down the other side."},{"bad":"They reached the valley by noon.","good":"They reached the valley by noon."}]},
      {"bad":"The swallows returned in spring. They flew in the open window. They nested under the roof. In autumn they flew away to warmer lands. They return to the same nest each year.","good":"The swallows returned in spring. They flew through the open window. They nested under the roof. In autumn they flew away to warmer lands. They return to the same nest each year.","explanation":"Use \"through\" for entering an opening, and \"away\" for departure.","sentences":[{"bad":"The swallows returned in spring.","good":"The swallows returned in spring."},{"bad":"They flew in the open window.","good":"They flew through the open window."},{"bad":"They nested under the roof.","good":"They nested under the roof."},{"bad":"In autumn they flew away to warmer lands.","good":"In autumn they flew away to warmer lands."},{"bad":"They return to the same nest each year.","good":"They return to the same nest each year."}]}
