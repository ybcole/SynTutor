.app-shell {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  height: 100vh;
  overflow: hidden;
  /* The sidebar is a pure fixed overlay that floats above the workspace:
     the collapsed icon rail reserves --rail-dock at the left edge of the
     workspace, while the expanded rail (--rail-w, 248px) and the left
     sub-panels hover over the workspace without ever reflowing it. */
  --rail-w: 60px;
  --rail-dock: 60px;
  --subpanel-w: 336px;
}
.app-shell:has(.app-sidebar.expanded) { --rail-w: 240px; }

/* --------------------------------------------------------------------------
   Left rail: one uniform width transition
   -------------------------------------------------------------------------- */
/* width, min-width, and max-width share a single 200ms curve so the rail
   collapses in one continuous motion instead of several competing ones, and
   `will-change`/`contain` keep the compositor on the width alone — no layout
   thrashing from the children fading in and out mid-animation. */
#appSidebar {
  transition:
    transform var(--dur) var(--ease),
    box-shadow 200ms cubic-bezier(0.2, 0, 0, 1),
    width 200ms cubic-bezier(0.2, 0, 0, 1),
    min-width 200ms cubic-bezier(0.2, 0, 0, 1),
    max-width 200ms cubic-bezier(0.2, 0, 0, 1);
  will-change: width;
  contain: layout style;
}

/* --------------------------------------------------------------------------
   The History rail item is an account-only feature: for a guest session it
   is hidden outright, so the column closes up without a gap or a ghost
   border where it used to sit.
   -------------------------------------------------------------------------- */
#appSidebar .sidebar-item[data-view="history"].is-guest-hidden {
  display: none !important;
}

/* --------------------------------------------------------------------------
   Left rail: a fixed icon slot, so the icons never move
   --------------------------------------------------------------------------
   The icon column is anchored. A 40px slot starts 10px from the rail's left
   edge in BOTH states: collapsed (60px) it reads as a centred column, expanded
   (240px) the label simply unfurls to the right of the very same slot. The
   icons therefore never travel a single pixel sideways. */
@media (min-width: 761px) {
  #appSidebar {
    width: 60px;
    min-width: 60px;
    max-width: 60px;
    padding: 12px 10px;
    box-sizing: border-box;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* width, min-width and max-width share one curve, so the rail opens in a
       single continuous motion instead of three competing ones. */
    transition:
      width 220ms cubic-bezier(0.2, 0, 0, 1),
      min-width 220ms cubic-bezier(0.2, 0, 0, 1),
      max-width 220ms cubic-bezier(0.2, 0, 0, 1);
    contain: layout style;
    will-change: width;
  }
  #appSidebar.expanded {
    width: 240px;
    min-width: 240px;
    max-width: 240px;
  }

  /* The header row stays a row in both states. */
  #appSidebar .app-sidebar-top {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }
  #appSidebar .sidebar-brand {
    flex: 1 1 auto;
    min-width: 0;
    gap: 0;
    padding: 0;
  }

  /* Every rail row: the same height, the same padding-free box, the same
     radius — an active destination highlights as a clean 40px pill. */
  #appSidebar .sidebar-item {
    display: flex;
    align-items: center;
    height: 40px;
    min-height: 40px;
    width: 100%;
    border-radius: 8px;
    padding: 0;
    margin: 2px 0;
    gap: 0;
    text-decoration: none;
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  /* The fixed icon slot: 40px wide, never shrinking, always the same
     distance from the rail's left edge. */
  #appSidebar .sidebar-item .sidebar-icon,
  #appSidebar .brand-logo-btn .sidebar-icon {
    width: 40px;
    min-width: 40px;
    max-width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  /* The glyph inside the slot keeps its own size, dead centre. */
  #appSidebar .sidebar-item svg,
  #appSidebar .brand-logo-btn svg,
  #appSidebar .sidebar-toggle svg {
    width: 20px;
    height: 20px;
    display: block;
    margin: auto;
    flex-shrink: 0;
    pointer-events: none;
  }

  /* The labels: clipped, faded out while collapsed, faded back in with a
     short delay once the rail has opened — never a reflow, never a pop. */
  #appSidebar .sidebar-label {
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    padding-left: 6px;
    opacity: 0;
    transform: translateX(-6px);
    pointer-events: none;
    transition: opacity 120ms ease, transform 120ms ease;
  }
  #appSidebar.expanded .sidebar-label {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    transition: opacity 180ms ease 50ms, transform 180ms ease 50ms;
  }

  /* The brand: a 40px monogram slot and a title that fades in with the rail. */
  #appSidebar .brand-logo-btn .brand-icon {
    width: 40px;
    min-width: 40px;
    max-width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #appSidebar .brand-monogram {
    margin: 0 auto;
  }
  #appSidebar .brand-title {
    font-size: 18px;
    font-weight: 800;
    white-space: nowrap;
  }

  /* The collapse toggle only exists while the rail is open — collapsed it
     would steal the icon's lane, so it is not rendered at all. */
  #appSidebar .sidebar-toggle {
    flex: 0 0 auto;
    margin-left: auto;
    width: 32px;
    height: 32px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease;
  }
  #appSidebar.expanded .sidebar-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    pointer-events: auto;
    animation: sidebar-fade-in 180ms ease 50ms;
  }
  @keyframes sidebar-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* The footer: two stacked rows, always. The theme toggle and the account
     chip are rail rows like every other destination, so nothing morphs from a
     column into a row while the width animates. */
  #appSidebar .app-sidebar-foot {
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    width: 100%;
    margin-top: auto;
    border-top: none;
    padding-top: 0;
  }
  #appSidebar .profile-anchor {
    display: block;
    width: 100%;
  }
  #appSidebar .profile-chip {
    justify-content: flex-start;
  }
  /* The account avatar: a 32px circle inside the same 40px lane. */
  #appSidebar .profile-icon {
    width: 40px;
    min-width: 40px;
    max-width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #appSidebar .profile-avatar {
    width: 32px;
    height: 32px;
    margin: 0 auto;
  }
  /* The separator above the footer: a short rule, centred. */
  .rail-divider { display: none; }
  #appSidebar:not(.expanded) .rail-divider {
    display: block;
    width: 36px;
    height: 1px;
    background: var(--border);
    margin: 8px auto;
    border: none;
    transition: width 220ms ease;
  }
  #appSidebar.expanded .rail-divider {
    display: block;
    width: calc(100% - 12px);
    height: 1px;
    background: var(--border);
    margin: 8px auto;
    border: none;
    transition: width 220ms ease;
  }

  /* The navigation list: one tidy rhythm. */
  #appSidebar .app-sidebar-nav { gap: 4px; }
}

/* --------------------------------------------------------------------------
   Rail active state — exactly one destination at a time
   -------------------------------------------------------------------------- */
/* main.js owns the `active` class and keeps it exclusive: the Syntax
   Generator, Lessons, Syntax Builder, History, Leaderboard, and Achievements
   never highlight at the same time, and the active one is always the module
   the workspace is currently showing. */
.sidebar-item.active {
  background: var(--accent-soft, rgba(99, 102, 241, 0.15));
  color: var(--accent-strong, #818cf8);
}
.sidebar-item.active svg {
  color: var(--accent-strong);
  stroke: var(--accent-strong);
}
/* Icons that paint a filled shape take the accent fill as well; the hollow,
   stroke-only icons keep their shape. */
.sidebar-item.active svg:not([fill="none"]) {
  fill: var(--accent-strong);
}

.menu-btn {
