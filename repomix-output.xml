<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SynTutor — Explainable Phrase-Structure Grammar Tutor</title>
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>
  <div class="app-shell">
    <div class="topbar">
      <div class="input-row">
        <div class="input-editor">
          <div id="inputHighlights" aria-hidden="true"></div>
          <textarea id="inputText" rows="4" readonly
                    placeholder="Type or paste a sentence or a whole paragraph, e.g.  The clever boy reads a book. He reads it every night."
                    spellcheck="false"></textarea>
        </div>
        <div class="input-actions">
          <button id="historyBtn" class="action-btn history-btn" type="button" title="View analysis history">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>History</span>
          </button>
          <button id="logoutBtn" class="action-btn logout-btn" type="button" title="Sign out">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Log Out</span>
          </button>
        </div>
      </div>
      <p id="inputHint" class="input-hint">Double-click the panel to edit. When locked, click any sentence to view its syntax tree.</p>
    </div>

    <main class="app-main">
      <section class="canvas-wrap">
        <canvas id="treeCanvas" tabindex="0" aria-label="Interactive syntax tree; click a node, or use arrow keys and Enter"></canvas>
        <div id="canvasOverlay" class="canvas-overlay"></div>
      </section>
      <aside class="panel right-panel">
        <section class="card primary-explainer">
          <div id="explainNode" class="node-explainer"></div>
        </section>
      </aside>
    </main>

    <details class="dev-panel" id="devPanel">
      <summary>
        <span class="dev-title">Developer panel</span>
        <span class="dev-meta">sentence verdict · benepar parse string · spaCy token stream · system/FSM log</span>
      </summary>
      <div class="dev-grid">
        <section class="card">
          <h3>Sentence verdict</h3>
          <div id="sentenceVerdict"><p class="muted">Submit a sentence to see the auto-generated pedagogical summary.</p></div>
        </section>
        <section class="card">
          <h3>benepar parse string</h3>
          <pre id="parseString" class="mono">—</pre>
        </section>
        <section class="card">
          <h3>Token stream (spaCy)</h3>
