        {
          "id": "6.18",
          "rule": "Reported speech",
          "example": "She said me",
          "check": "T+C",
          "difficulty": "hard",
          "concept": "Reported speech shifts tense and uses \"tell + person\" or \"say + clause\" (\"She told me\", not \"She said me\")."
        },
        {
          "id": "6.19",
          "rule": "Causatives and perception verbs",
          "example": "made me to cry",
          "check": "T+L",
          "difficulty": "medium",
          "concept": "Causative and perception verbs take specific structures: \"make/let + base\", \"have/get + past participle\", \"see + base/-ing\"."
        },
        {
          "id": "6.20",
          "rule": "Verb + clause patterns",
          "example": "suggest him to go",
          "check": "L",
          "difficulty": "easy",
          "concept": "Different verbs select different clause patterns (\"suggest going\", \"advise someone to go\"), so the complement must match the verb."
        }
      ]
    },
    {
      "id": 7,
      "title": "Adjectives and adverbs",
      "rules": [
        {
          "id": "7.1",
          "rule": "Adjective vs adverb",
          "example": "runs quick",
          "check": "T+L",
          "difficulty": "medium",
          "concept": "Adjectives modify nouns; adverbs modify verbs, adjectives, or other adverbs. Use the adverb after an action verb (\"runs quickly\")."
        },
        {
          "id": "7.2",
          "rule": "Adjective order",
          "example": "red big car",
          "check": "L",
          "difficulty": "easy",
          "concept": "When several adjectives stack, English fixes their order: opinion, size, age, shape, colour, origin, material, purpose."
        },
        {
          "id": "7.3",
          "rule": "Adverb placement",
          "example": "I like very much it",
          "check": "T+L",
          "difficulty": "medium",
          "concept": "Adverbs of frequency and degree have preferred positions and usually cannot split a verb and its object."
        },
        {
          "id": "7.4",
          "rule": "Participial adjectives",
          "example": "I am boring",
          "check": "L",
          "difficulty": "easy",
          "concept": "Participial adjectives differ: \"-ing\" describes the cause (\"boring\"), \"-ed\" describes the feeler (\"bored\")."
        },
        {
          "id": "7.5",
          "rule": "Intensifiers and degree",
          "example": "enough big",
          "check": "T+L",
          "difficulty": "medium",
          "concept": "Degree words combine with the right adjective and position: \"big enough\", \"very good\", \"too big\" — not \"enough big\"."
        },
        {
          "id": "7.6",
          "rule": "Comparative structures",
          "example": "more taller",
          "check": "T+L",
          "difficulty": "medium",
          "concept": "Form comparatives once: either -er/-est or more/most, and use \"than\" for comparison (\"taller than\")."
        },
        {
          "id": "7.7",
          "rule": "Modifier position",
          "example": "the car red",
          "check": "T",
          "difficulty": "medium",
          "concept": "English puts most modifiers before the noun; reversing the order (\"the car red\") is ungrammatical."
        }
      ]
    },
    {
      "id": 8,
      "title": "Prepositions",
      "rules": [
        {
          "id": "8.1",
          "rule": "Wrong preposition",
          "example": "depends in",
          "check": "C",
          "difficulty": "hard",
          "concept": "The preposition a verb or adjective takes is fixed by convention (\"depend on\", not \"depend in\")."
        },
        {
          "id": "8.2",
          "rule": "Missing preposition",
          "example": "listen music",
          "check": "C",
          "difficulty": "hard",
          "concept": "Some verbs require a preposition to introduce their object (\"listen to music\", not \"listen music\")."
        },
        {
          "id": "8.3",
          "rule": "Unnecessary preposition",
          "example": "discuss about",
          "check": "L",
          "difficulty": "easy",
          "concept": "Some verbs already include the meaning of the preposition, so adding one is wrong (\"discuss the plan\")."
        },
        {
          "id": "8.4",
          "rule": "Adjective + preposition",
          "example": "interested on",
          "check": "L",
          "difficulty": "easy",
          "concept": "Adjective + preposition pairs are fixed (\"interested in\", \"good at\", \"afraid of\")."
        },
        {
          "id": "8.5",
          "rule": "Time and place (in/on/at)",
          "example": "on 5 pm",
          "check": "L+C",
          "difficulty": "hard",
          "concept": "Time and place prepositions follow set patterns: \"at\" a point, \"on\" a day/date, \"in\" a period/area."
        },
        {
          "id": "8.6",
          "rule": "Preposition + gerund",
          "example": "look forward to see",
          "check": "T+L",
          "difficulty": "medium",
          "concept": "A preposition is followed by a noun or a gerund (\"look forward to seeing\"), not a bare infinitive."
        }
      ]
    },
    {
      "id": 9,
      "title": "Sentence structure",
      "rules": [
        {
          "id": "9.1",
          "rule": "Fragment",
          "example": "Because I was late.",
          "check": "T",
          "difficulty": "medium",
          "concept": "A sentence needs at least one independent clause; a subordinate clause alone is a fragment (\"Because I was late\" cannot stand alone)."
        },
        {
          "id": "9.2",
          "rule": "Missing subject",
          "example": "Went to school.",
          "check": "T",
          "difficulty": "medium",
          "concept": "A finite clause needs a subject; leaving it out produces a fragment (\"I went to school\")."
        },
        {
          "id": "9.3",
          "rule": "Run-on / fused sentence",
          "example": "I like tea she likes coffee",
          "check": "T+C",
          "difficulty": "hard",
          "concept": "Two independent clauses cannot sit side by side without a conjunction or punctuation (\"I like tea, but she likes coffee\")."
        },
        {
          "id": "9.4",
          "rule": "Comma splice",
          "example": "I came, I saw.",
          "check": "T",
          "difficulty": "medium",
          "concept": "A comma alone cannot join two independent clauses; use a conjunction, a semicolon, or a full stop."
        },
        {
          "id": "9.5",
          "rule": "Double subject",
          "example": "My brother he...",
          "check": "T",
          "difficulty": "medium",
          "concept": "Do not give the subject twice with a pronoun (\"My brother went\", not \"My brother he went\")."
        },
        {
          "id": "9.6",
          "rule": "Word order in statements",
          "example": "Yesterday went I",
          "check": "T",
          "difficulty": "medium",
          "concept": "Statements use subject-before-verb order; inverted order belongs only to questions (\"Yesterday I went\")."
        },
        {
          "id": "9.7",
          "rule": "Missing or extra word",
          "example": "She is very the happy",
          "check": "C",
          "difficulty": "hard",
          "concept": "A clause should carry exactly the words it needs; extras or omissions break the structure (\"She is very happy\")."
        },
        {
          "id": "9.8",
          "rule": "Parallel structure",
          "example": "to run, swimming",
          "check": "T",
          "difficulty": "medium",
          "concept": "Items in a list or comparison must share the same grammatical form (\"to run and to swim\", not \"to run and swimming\")."
        },
        {
          "id": "9.9",
          "rule": "Conjunction pairing",
          "example": "Although..., but...",
          "check": "L",
          "difficulty": "easy",
          "concept": "Correlative conjunctions come in fixed pairs; do not add a second connector (\"Although X, Y\" without \"but\")."
        },
        {
          "id": "9.10",
          "rule": "Relative clause formation",
          "example": "the man who I saw him",
          "check": "T",
          "difficulty": "medium",
          "concept": "A relative clause already contains the role of the antecedent, so do not repeat it with a pronoun (\"the man who I saw\")."
        },
        {
          "id": "9.11",
          "rule": "Dangling / misplaced modifier",
          "example": "Walking home, the rain started",
          "check": "C",
          "difficulty": "hard",
          "concept": "A modifier at the start of a sentence should describe the subject of the main clause (\"Walking home, I saw the rain start\")."
        },
        {
          "id": "9.12",
          "rule": "Redundancy",
          "example": "return back",
          "check": "L",
          "difficulty": "easy",
          "concept": "Avoid redundant words that repeat meaning (\"return\", not \"return back\")."
        },
        {
          "id": "9.13",
          "rule": "Indirect question word order",
          "example": "I wonder where is he",
          "check": "T",
          "difficulty": "medium",
          "concept": "An embedded question keeps statement word order (\"I wonder where he is\")."
        },
        {
          "id": "9.14",
          "rule": "Clause linking",
          "example": "because to see you",
          "check": "T",
          "difficulty": "medium",
          "concept": "Link clauses with the structure each connector requires (\"because I wanted to see you\")."
        },
        {
          "id": "9.15",
          "rule": "Object order",
          "example": "gave to me a book",
          "check": "T+L",
          "difficulty": "medium",
          "concept": "Give the direct and indirect object in the standard order, or use the right preposition (\"give me a book\", \"give a book to me\")."
        }
      ]
    },
    {
      "id": 10,
      "title": "Punctuation and orthography",
      "rules": [
        {
          "id": "10.1",
          "rule": "Sentence-initial capital",
          "example": "the boy runs",
          "check": "T",
          "difficulty": "medium",
          "concept": "Begin every sentence with a capital letter."
        },
        {
          "id": "10.2",
          "rule": "Proper nouns, \"I\", days, months",
          "example": "i am, monday",
          "check": "L",
          "difficulty": "easy",
          "concept": "Capitalise proper nouns, the pronoun \"I\", and the names of days and months."
        },
        {
          "id": "10.3",
          "rule": "Terminal punctuation",
          "example": "missing period",
          "check": "T",
          "difficulty": "medium",
          "concept": "End a declarative or imperative sentence with a full stop, a question with \"?\" and a strong exclamation with \"!\"."
        },
        {
          "id": "10.4",
          "rule": "Commas",
          "example": "series, introductory, clauses",
          "check": "T+C",
          "difficulty": "hard",
          "concept": "Commas separate list items, mark introductory phrases, and set off non-essential clauses — but they cannot join two main clauses."
        },
        {
          "id": "10.5",
          "rule": "Apostrophes",
          "example": "the 1990’s",
          "check": "T",
          "difficulty": "medium",
          "concept": "Apostrophes mark possession and contraction, not ordinary plurals (\"the 1990s\")."
        },
        {
          "id": "10.6",
          "rule": "Quotation and dialogue",
          "example": "mismatched marks",
          "check": "T",
          "difficulty": "medium",
          "concept": "Quotation marks must be opened and closed around the exact words, with punctuation placed correctly."
        },
        {
          "id": "10.7",
          "rule": "Hyphens and dashes",
          "example": "a well known author",
          "check": "C",
          "difficulty": "hard",
          "concept": "Use hyphens to join compound modifiers before a noun (\"a well-known author\") and dashes for breaks in a sentence."
        },
        {
          "id": "10.8",
          "rule": "Colons and semicolons",
          "example": "misuse",
          "check": "T+C",
          "difficulty": "hard",
          "concept": "Use a colon to introduce a list or explanation and a semicolon to join closely related independent clauses."
        },
        {
          "id": "10.9",
          "rule": "Spacing and repeats",
          "example": "the the",
          "check": "T",
          "difficulty": "medium",
          "concept": "Use single spaces between words and avoid accidental repeated words (\"the the\")."
        },
        {
          "id": "10.10",
          "rule": "Numbers, dates, abbreviations",
          "example": "inconsistent format",
          "check": "L",
          "difficulty": "easy",
          "concept": "Follow consistent conventions for numbers, dates, and abbreviations within a text."
        }
      ]
    },
    {
      "id": 11,
      "title": "Meaning and usage",
      "rules": [
        {
          "id": "11.1",
          "rule": "Confusable words",
          "example": "affect/effect",
          "check": "C",
          "difficulty": "hard",
          "concept": "Confusable words sound or look alike but differ in meaning or part of speech (\"affect\" = verb, \"effect\" = noun)."
        },
        {
          "id": "11.2",
          "rule": "Collocations",
          "example": "do a decision",
          "check": "C",
          "difficulty": "hard",
          "concept": "Collocations are word partnerships fixed by convention (\"make a decision\", not \"do a decision\")."
        },
        {
          "id": "11.3",
          "rule": "Tense-time agreement",
          "example": "Yesterday I go",
          "check": "C",
          "difficulty": "hard",
          "concept": "The tense must match the time expressed by adverbs such as \"yesterday\" (\"Yesterday I went\")."
        },
        {
          "id": "11.4",
          "rule": "Selectional restrictions",
          "example": "The book eats",
          "check": "C",
          "difficulty": "hard",
          "concept": "A verb’s meaning restricts what can be its subject or object (\"The book eats\" is impossible)."
        },
        {
          "id": "11.5",
          "rule": "Structural ambiguity",
          "example": "PP-attachment",
          "check": "C",
          "difficulty": "hard",
          "concept": "Some sentences have more than one possible structure; the intended meaning should be made explicit."
        },
        {
          "id": "11.6",
          "rule": "Register",
          "example": "slang in formal writing",
          "check": "C",
          "difficulty": "hard",
          "concept": "Register should match the situation: slang and casual forms do not belong in formal writing."
        },
        {
          "id": "11.7",
          "rule": "L1 interference / false friends",
          "example": "I am agree",
          "check": "C",
          "difficulty": "hard",
          "concept": "First-language patterns can produce errors in English (\"I am agree\" from \"estoy de acuerdo\"); use the English structure."
        },
        {
          "id": "11.8",
          "rule": "Connector misuse",
          "example": "I was tired, however I slept",
          "check": "C",
          "difficulty": "hard",
          "concept": "Connectors express a specific logical relation, so the one chosen must match the meaning (\"I was tired, so I slept\")."
        }
      ]
    }
  ],
