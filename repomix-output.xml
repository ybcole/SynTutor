    "10.5": [
      {"bad":"The dog ran across the field. The dogs bone was buried in the garden. He dug it up again at once. The childrens toys lay scattered on the grass. The garden was a cheerful mess.","good":"The dog ran across the field. The dog's bone was buried in the garden. He dug it up again at once. The children's toys lay scattered on the grass. The garden was a cheerful mess.","explanation":"Use an apostrophe for possession: \"the dog's bone\", \"the children's toys\".","sentences":[{"bad":"The dog ran across the field.","good":"The dog ran across the field."},{"bad":"The dogs bone was buried in the garden.","good":"The dog's bone was buried in the garden."},{"bad":"He dug it up again at once.","good":"He dug it up again at once."},{"bad":"The childrens toys lay scattered on the grass.","good":"The children's toys lay scattered on the grass."},{"bad":"The garden was a cheerful mess.","good":"The garden was a cheerful mess."}]},
      {"bad":"The pupils handed in their work. The teachers desk was covered in papers. She marked the books at home. The pupils answers were mostly correct. The class did very well.","good":"The pupils handed in their work. The teacher's desk was covered in papers. She marked the books at home. The pupils' answers were mostly correct. The class did very well.","explanation":"Singular \"teacher's\" and plural \"pupils'\" both take an apostrophe.","sentences":[{"bad":"The pupils handed in their work.","good":"The pupils handed in their work."},{"bad":"The teachers desk was covered in papers.","good":"The teacher's desk was covered in papers."},{"bad":"She marked the books at home.","good":"She marked the books at home."},{"bad":"The pupils answers were mostly correct.","good":"The pupils' answers were mostly correct."},{"bad":"The class did very well.","good":"The class did very well."}]},
      {"bad":"My sister borrowed my bike. My sisters helmet was left at home. She had to walk back for it. The boys bags were by the door. They set off later than planned.","good":"My sister borrowed my bike. My sister's helmet was left at home. She had to walk back for it. The boys' bags were by the door. They set off later than planned.","explanation":"Use \"sister's\" for one owner and \"boys'\" for many.","sentences":[{"bad":"My sister borrowed my bike.","good":"My sister borrowed my bike."},{"bad":"My sisters helmet was left at home.","good":"My sister's helmet was left at home."},{"bad":"She had to walk back for it.","good":"She had to walk back for it."},{"bad":"The boys bags were by the door.","good":"The boys' bags were by the door."},{"bad":"They set off later than planned.","good":"They set off later than planned."}]},
      {"bad":"The team celebrated the win. The captains speech was short and cheerful. The players cheered loudly. The womens match was played first. Both teams played well.","good":"The team celebrated the win. The captain's speech was short and cheerful. The players cheered loudly. The women's match was played first. Both teams played well.","explanation":"Note the apostrophe in \"captain's\" and the irregular \"women's\".","sentences":[{"bad":"The team celebrated the win.","good":"The team celebrated the win."},{"bad":"The captains speech was short and cheerful.","good":"The captain's speech was short and cheerful."},{"bad":"The players cheered loudly.","good":"The players cheered loudly."},{"bad":"The womens match was played first.","good":"The women's match was played first."},{"bad":"Both teams played well.","good":"Both teams played well."}]},
      {"bad":"The company held its annual picnic. The firms staff gathered in the park. There were games for everyone. The managers speech ended the day. Everyone went home happy.","good":"The company held its annual picnic. The firm's staff gathered in the park. There were games for everyone. The manager's speech ended the day. Everyone went home happy.","explanation":"Use \"firm's\" and \"manager's\" for possession.","sentences":[{"bad":"The company held its annual picnic.","good":"The company held its annual picnic."},{"bad":"The firms staff gathered in the park.","good":"The firm's staff gathered in the park."},{"bad":"There were games for everyone.","good":"There were games for everyone."},{"bad":"The managers speech ended the day.","good":"The manager's speech ended the day."},{"bad":"Everyone went home happy.","good":"Everyone went home happy."}]}
