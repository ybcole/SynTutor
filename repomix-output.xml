      </section>

      <div id="colResizer" class="resizer resizer-col" role="separator" aria-orientation="vertical"
           aria-label="Resize the workspace — drag, or double-click to reset" title="Drag to resize · double-click to reset"></div>

      <div class="pane-side lesson-right-column">
        <section class="pane pane-input panel-upper-right">
          <button id="mobileNavBtn" class="menu-btn mobile-nav-btn" type="button" aria-label="Open menu" title="Menu" aria-expanded="false" aria-controls="appSidebar">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div class="input-row" id="tutorSurface">
            <div class="input-editor">
              <div id="inputHighlights" aria-hidden="true"></div>
              <textarea id="inputText" class="input-textarea" rows="4" readonly spellcheck="false"
                        placeholder="Click the panel to write a sentence. SynTutor builds its syntax tree and analysis automatically."></textarea>
            </div>
          </div>
          <button id="inputClearBtn" class="input-clear" type="button" aria-label="Clear input" title="Clear text">×</button>
          <div id="quizQuestHost"></div>
        </section>

        <div id="rowResizer" class="resizer resizer-row" role="separator" aria-orientation="horizontal"
             aria-label="Resize the workspace — drag, or double-click to reset" title="Drag to resize · double-click to reset"></div>

        <section class="pane pane-explain panel-lower-right analysis-panel">
          <div id="lessonGuideHost" class="guide-host"></div>
          <div id="correctionPanel" class="correction-panel" hidden></div>
          <div id="explainNode" class="node-explainer"></div>
          <div id="emptyExplainState" class="empty-state-explain">
            <svg class="empty-book-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              <path d="M12 2v15"></path>
            </svg>
            <p class="empty-explain-title">Ready for Analysis</p>
          </div>
        </section>
      </div>
    </main>

    <div id="lessonsOverlay" class="lessons-overlay">
      <div class="lessons-sheet" role="dialog" aria-label="Lessons">
        <div class="lessons-main sq-catalog-container">
          <!-- The content body: the toolbar and the card grid. -->
          <div class="sq-catalog-content">
            <!-- Catalog toolbar: the inline category expander on the left, the
                 completion counter on the right. -->
            <div class="sq-catalog-toolbar" id="lessonsToolbar">
              <div class="sq-cat" id="lessonsCategory"></div>
              <p id="lessonsSummary" class="lessons-summary"></p>
            </div>
            <div id="lessonsGrid" class="sq-catalog-grid"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Leaderboard: a full-bleed workspace view, docked next to the rail —
     the same surface the lessons catalog uses, not a centered dialog. -->
    <div id="leaderboardView" class="workspace-view" aria-hidden="true">
      <header class="view-header leaderboard-header">
        <h2 class="view-title">Leaderboard</h2>
      </header>
      <div class="leaderboard-content-wrapper">
        <!-- The podium: the three strongest learners, side by side. -->
        <div class="podium-grid" id="leaderboardPodium"></div>
        <section class="standings-section">
          <h2 class="standings-title">Standings</h2>
          <div class="standings-table-container">
            <table class="standings-table">
              <thead>
                <tr>
                  <th scope="col">Rank</th>
                  <th scope="col">Learner</th>
                  <th scope="col" class="num">Trees Built</th>
                  <th scope="col" class="num">Accuracy</th>
                  <th scope="col" class="num">XP</th>
                </tr>
              </thead>
              <tbody id="leaderboardRows"></tbody>
            </table>
          </div>
        </section>
      </div>
    </div>

    <!-- Achievements: a full-bleed workspace view — the same page frame as the
         leaderboard, with the category filters above the card grid. -->
    <div id="achievementsView" class="workspace-view" aria-hidden="true">
      <header class="view-header achievements-header">
        <h2 class="view-title">Achievements</h2>
        <div class="achievements-xp-tracker">
          <div class="xp-tracker-label" id="achievementsProgressLabel">Sign in to track your progress.</div>
          <div class="xp-progress-bar-track">
            <div class="xp-progress-bar-fill" id="achievementsProgressFill"></div>
          </div>
        </div>
      </header>
      <div class="achievements-content-wrapper">
        <div class="achievements-toolbar">
          <!-- The category selector unfurls inline, lessons-catalog style. -->
          <div class="expanding-cat-wrapper" id="achievementsCatExpander">
            <button class="cat-trigger-pill" id="achievementsCatTrigger" type="button" aria-expanded="false" aria-haspopup="true">
              <span class="cat-trigger-label">All</span>
              <svg class="cat-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            <div class="expanding-cat-pills" id="achievementsCatPills">
              <button class="cat-pill active" type="button" data-category="all">All</button>
              <button class="cat-pill" type="button" data-category="basics">Syntax Basics</button>
              <button class="cat-pill" type="button" data-category="speed">Speed &amp; Accuracy</button>
              <button class="cat-pill" type="button" data-category="streaks">Streaks</button>
              <button class="cat-pill" type="button" data-category="mastery">Mastery</button>
            </div>
          </div>
          <div class="achievements-stats-counter" id="achievementsStatsCounter">0 of 0 unlocked · 0% completed</div>
        </div>
        <div class="achievements-grid" id="achievementsGrid"></div>
      </div>
    </div>

    <!-- The one auth dialog: the sidebar login and the lessons gateway use
         this very same modal, only the framing changes. -->
    <div id="authModal" class="auth-modal-backdrop" hidden>
      <div class="auth-modal-card" role="dialog" aria-modal="true" aria-labelledby="authModalTitle">
        <button id="authModalCloseBtn" class="auth-modal-close" type="button" aria-label="Close modal">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>

        <h3 id="authModalTitle" class="auth-modal-title">Sign in to SynTutor</h3>
        <p id="authModalSubtitle" class="auth-modal-subtitle">Save your progress, sync syntax trees, and view rankings.</p>

        <!-- Mode Switcher Tabs -->
        <div class="auth-tab-group">
          <button id="authTabSignIn" class="auth-tab-pill active" type="button">Sign In</button>
          <button id="authTabRegister" class="auth-tab-pill" type="button">Create Account</button>
        </div>

        <!-- Unified Form -->
        <form id="authForm" class="auth-form" autocomplete="on">
          <div class="auth-field-group">
            <label for="authEmailInput">EMAIL</label>
            <input id="authEmailInput" type="email" placeholder="you@example.com" required />
          </div>

          <div class="auth-field-group">
            <label for="authPasswordInput">PASSWORD</label>
            <div class="auth-password-wrapper">
              <input id="authPasswordInput" type="password" placeholder="At least 6 characters" required />
              <button type="button" id="authTogglePasswordBtn" class="auth-password-eye" aria-label="Toggle password visibility">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
            <div id="authPasswordReqs" class="password-reqs" hidden></div>
          </div>

          <p id="authModalStatus" class="auth-modal-status" hidden></p>

          <button id="authSubmitBtn" class="auth-primary-btn" type="submit">Sign In</button>
        </form>

        <!-- Bottom Switcher Links -->
        <div class="auth-footer-links">
          <button id="authSwitchModeBtn" class="auth-text-link" type="button">Need an account? Create one</button>
          <button id="authDismissGuestBtn" class="auth-text-link muted" type="button">Continue as guest</button>
        </div>
      </div>
    </div>
  </div>

  <script src="js/config-hint.js"></script>
  <script type="module" src="js/main.js"></script>
</body>
</html>
