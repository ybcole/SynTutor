  --dur: 0.3s;
  --dur-slow: 0.38s;
  color-scheme: light;
}

[data-theme="dark"] {
  --bg: #0f1117;
  --panel: #181b24;
  --surface: #1e222d;
  --ink: #f1f5f9;
  --muted: #94a3b8;
  --accent: #8b7cf1;
  --accent-strong: #a295ff;
  --accent-soft: rgba(109, 90, 230, 0.16);
  --border: #2e3442;
  --card-border: #2e3442;
  --header-bg: #13151f;
  --header-text: #f8fafc;
  --header-border: rgba(255, 255, 255, 0.08);
  --header-hover: rgba(255, 255, 255, 0.12);
  --header-chip-bg: rgba(255, 255, 255, 0.06);
  --header-chip-border: rgba(255, 255, 255, 0.18);
  --empty-icon: #64748b;
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.25);
