    "11.7": [
      {"bad":"The scientist presented the findings. The results were really awesome. The committee reviewed the data. The method was kinda unusual. The report was accepted.","good":"The scientist presented the findings. The results were excellent. The committee reviewed the data. The method was somewhat unusual. The report was accepted.","explanation":"In formal writing, choose \"excellent\" and \"somewhat\" over informal words.","sentences":[{"bad":"The scientist presented the findings.","good":"The scientist presented the findings."},{"bad":"The results were really awesome.","good":"The results were excellent."},{"bad":"The committee reviewed the data.","good":"The committee reviewed the data."},{"bad":"The method was kinda unusual.","good":"The method was somewhat unusual."},{"bad":"The report was accepted.","good":"The report was accepted."}]},
      {"bad":"The manager wrote to the client. The delay was a big mess. She promised a full investigation. The client was pretty annoyed. The matter was resolved quickly.","good":"The manager wrote to the client. The delay was a serious problem. She promised a full investigation. The client was rather annoyed. The matter was resolved quickly.","explanation":"Replace informal expressions with formal equivalents.","sentences":[{"bad":"The manager wrote to the client.","good":"The manager wrote to the client."},{"bad":"The delay was a big mess.","good":"The delay was a serious problem."},{"bad":"She promised a full investigation.","good":"She promised a full investigation."},{"bad":"The client was pretty annoyed.","good":"The client was rather annoyed."},{"bad":"The matter was resolved quickly.","good":"The matter was resolved quickly."}]},
