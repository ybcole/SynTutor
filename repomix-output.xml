}
@media (min-width: 761px) {
  .drawer-backdrop,
  .side-subpanel {
    position: static;
    inset: auto;
    z-index: auto;
    width: 0;
    overflow: hidden;
    opacity: 1;
    visibility: visible;
    pointer-events: none;
    background: none;
    transition: width var(--dur) var(--ease);
  }
  .drawer-backdrop.active,
  .side-subpanel.active {
    width: var(--subpanel-w, 336px);
    pointer-events: auto;
  }
  .drawer-backdrop.active .history-drawer,
  .side-subpanel.active .history-drawer {
