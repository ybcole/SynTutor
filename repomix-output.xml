.sq-dot.ready { background: var(--ok); }
.sq-dot.soon { background: var(--muted); opacity: 0.5; }
.sq-row-foot { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.sq-bad { font-size: 11.5px; font-style: italic; color: var(--err); }
.sq-soon {
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--muted);
}
.sq-empty { color: var(--muted); font-size: 13px; padding: 24px 4px; text-align: center; }

/* ---- Inline rule expansion ------------------------------------------ */
.sq-rule-item { display: flex; flex-direction: column; }
.sq-rule-panel {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  padding: 0 4px 6px;
}
.sq-rule-panel[hidden] { display: none; }
.sq-rule-panel .sq-soon-text { margin: 0; width: 100%; text-align: left; }
.sq-start-inline {
  padding: 6px 14px;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--accent);
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.sq-start-inline:hover { background: var(--accent-strong); }
.sq-start-inline:active { transform: scale(0.98); }

/* ---- Setup ---------------------------------------------------------- */
.sq-intro {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7px;
  padding: 4px 4px 12px;
}
.sq-intro-id { font-size: 12px; font-weight: 700; color: var(--accent); }
.sq-intro-rule { font-size: 12.5px; color: var(--ink); }
.sq-primary {
  padding: 11px 16px;
  margin: 0 4px;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--accent);
  color: #fff;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.sq-primary:hover {
  background: var(--accent-strong);
  box-shadow: 0 2px 8px color-mix(in srgb, var(--accent) 32%, transparent);
}
.sq-primary:active { transform: scale(0.98); box-shadow: none; }
.sq-primary:disabled { opacity: 0.45; cursor: not-allowed; box-shadow: none; }
.sq-ghost {
  padding: 11px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--ink);
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.sq-ghost:hover { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-strong); }
/* Keyboard users get the same accent feedback as hover, everywhere a
   lesson/quiz control is rendered. */
.sq-primary:focus-visible,
.sq-ghost:focus-visible,
.sq-pager-pill:focus-visible,
.sq-example-pill:focus-visible,
.sq-lessons-back:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
.sq-soon-box { padding: 16px 12px; border: 1px dashed var(--border); border-radius: var(--radius-sm); margin: 4px; }
.sq-soon-text { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; }

/* ---- Quest meta ----------------------------------------------------- */
.sq-meta {
  flex: 0 0 auto;
  padding: 4px 4px 8px;
}
.sq-meta-line { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
.sq-meta-rule {
  font-size: 12px;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sq-meta-diff {
  flex: 0 0 auto;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent-strong);
}
.sq-progress {
  height: 6px;
  border-radius: 999px;
  background: var(--header-chip-bg);
  overflow: hidden;
  margin-bottom: 10px;
}
.sq-progress-fill { height: 100%; background: var(--accent); transition: width var(--dur) var(--ease); }
.sq-sentence {
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  background: var(--accent-soft);
}
.sq-sentence-label {
  display: block;
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent-strong);
  margin-bottom: 3px;
}
.sq-sentence p { margin: 0; font-size: 13px; line-height: 1.45; color: var(--ink); }

/* ---- Question ------------------------------------------------------- */
.sq-num {
  margin: 4px 4px 6px;
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
}
.sq-prompt {
  margin: 0 4px 12px;
  font-size: 14.5px;
  line-height: 1.45;
  color: var(--ink);
}
.sq-options { display: flex; flex-direction: column; gap: 8px; padding: 0 4px; }
.sq-option {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 12px;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--ink);
  font-size: 13.5px;
  text-align: left;
  cursor: pointer;
  transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
}
.sq-option:not(:disabled):hover { border-color: var(--accent); background: var(--accent-soft); }
.sq-option:disabled { cursor: default; }
.sq-option-key {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--header-chip-bg);
  font-size: 11px;
  font-weight: 700;
  color: var(--muted);
}
.sq-option.correct { border-color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); }
.sq-option.correct .sq-option-key { background: var(--ok); color: #fff; }
.sq-option.wrong { border-color: var(--err); background: color-mix(in srgb, var(--err) 12%, transparent); }
.sq-option.wrong .sq-option-key { background: var(--err); color: #fff; }
.sq-feedback {
  display: none;
  margin: 12px 4px 0;
  font-size: 13px;
  line-height: 1.5;
  color: var(--ink);
}
.sq-feedback.show { display: block; padding: 10px 12px; border-radius: var(--radius-sm); }
.sq-feedback.ok { background: color-mix(in srgb, var(--ok) 12%, transparent); }
.sq-feedback.err { background: color-mix(in srgb, var(--err) 10%, transparent); }
.sq-feedback strong { margin-right: 3px; }
.sq-nav { display: flex; gap: 8px; padding: 14px 4px 0; }
.sq-nav .sq-ghost { flex: 0 0 auto; margin: 0; }
.sq-nav .sq-primary { flex: 1 1 auto; margin: 0; }

/* ---- Results -------------------------------------------------------- */
.sq-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 10px 4px 14px;
}
.sq-score-num { font-size: 34px; font-weight: 700; letter-spacing: -1px; color: var(--accent); }
.sq-score-sub { font-size: 12px; color: var(--muted); text-align: center; }
.sq-review { display: flex; flex-direction: column; gap: 6px; padding: 14px 4px 0; }
.sq-review-row {
  padding: 9px 10px;
  border: 1px solid var(--border);
  border-left-width: 4px;
  border-radius: var(--radius-sm);
  background: var(--surface);
}
.sq-review-row.ok { border-left-color: var(--ok); }
.sq-review-row.err { border-left-color: var(--err); }
.sq-review-row.skip { border-left-color: var(--muted); }
.sq-review-head { display: flex; align-items: center; gap: 8px; }
.sq-review-i {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--header-chip-bg);
  font-size: 10px;
  font-weight: 700;
  color: var(--muted);
}
.sq-review-sent { flex: 1 1 auto; font-size: 12.5px; color: var(--ink); white-space: pre-line; }
.sq-review-mark { font-size: 14px; font-weight: 700; }
.sq-review-row.ok .sq-review-mark { color: var(--ok); }
.sq-review-row.err .sq-review-mark { color: var(--err); }
.sq-review-row.skip .sq-review-mark { color: var(--muted); }
.sq-review-ans { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; padding-left: 28px; font-size: 11.5px; }
.sq-review-correct { color: var(--ok); }
.sq-review-yours { color: var(--muted); }
.sq-actions { display: flex; flex-direction: column; gap: 8px; padding: 16px 4px 0; }
.sq-actions .sq-primary, .sq-actions .sq-ghost { margin: 0; }

/* ------------------------------------------------------------------ */
/* Lesson controls (#quizQuestHost) — slim stack in the input pane     */
/* ------------------------------------------------------------------ */
/* Back pill, title, page pills, the always-visible example pills and
   the Back / Next / Start-quiz nav stack compactly at the bottom of
   the upper-right pane; the current page's content renders into
   #lessonGuideHost (the scrolling card in the explain pane). Empty →
   nothing. */
#quizQuestHost:not(:empty) {
  flex: 0 0 auto;
  min-height: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  overflow-y: auto;
}
#quizQuestHost:empty { display: none; }

.quiz-quest { padding: 0; overflow: hidden; }

.qq-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 14px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  cursor: pointer;
}
.qq-head-main { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; flex: 1 1 auto; min-width: 0; }
.qq-cat {
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.qq-concept {
  margin: 0;
  font-size: 12.5px;
  line-height: 1.4;
  color: var(--muted);
}
.qq-collapse {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  flex: 0 0 auto;
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.qq-collapse:hover { background: var(--accent-soft); color: var(--accent); }

.qq-body { padding: 14px; display: flex; flex-direction: column; gap: 12px; }

.qq-progress { height: 6px; border-radius: 999px; background: var(--header-chip-bg); overflow: hidden; }
.qq-progress-fill { height: 100%; background: var(--accent); transition: width var(--dur) var(--ease); }

.qq-meta-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.qq-num {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
}
.qq-score { font-size: 11px; font-weight: 700; color: var(--accent-strong); }

.qq-target { padding: 10px 12px; border-radius: var(--radius-sm); background: var(--accent-soft); }
.qq-label {
  display: block;
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent-strong);
  margin-bottom: 3px;
}
.qq-sentence { margin: 0; font-size: 14px; line-height: 1.45; color: var(--ink); }
.qq-paragraph {
  display: grid;
  gap: 7px;
  margin: 6px 0 0;
  padding-left: 26px;
}
.qq-paragraph-line { padding-left: 2px; }
.qq-paragraph-line::marker { color: var(--accent-strong); font-weight: 700; }
.qq-paragraph .qq-sentence { display: block; }

.qq-answer { padding: 10px 12px; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--ok) 12%, transparent); }
.qq-answer[hidden] { display: none; }
.qq-answer .qq-label { color: var(--ok); }
.qq-good { margin: 0; font-size: 13.5px; line-height: 1.45; color: var(--ink); font-weight: 600; }

.qq-nav { display: flex; gap: 8px; }
.qq-nav .sq-ghost { flex: 0 0 auto; margin: 0; }
.qq-nav .sq-primary { flex: 1 1 auto; margin: 0; }

.qq-quit {
  align-self: flex-start;
  padding: 2px 0;
  border: none;
  background: transparent;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
  text-decoration: underline;
  cursor: pointer;
}
.qq-quit:hover { color: var(--err); }

/* Reset sidebar-oriented margins when the results view lives on canvas */
.qq-body .sq-score { padding: 4px 0 8px; }
.qq-body .sq-review { padding: 0; }
.qq-body .sq-actions { padding: 4px 0 0; }
.qq-body .sq-actions .sq-primary,
.qq-body .sq-actions .sq-ghost { margin: 0; }

/* ------------------------------------------------------------------ */
/* Gamification — XP / level / permanent leaderboard                   */
/* ------------------------------------------------------------------ */
.sq-progress-note { margin: 0; font-size: 11.5px; color: var(--muted); }

.sq-board {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin: 0;
  padding: 0 4px;
  list-style: none;
}
.sq-board-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
}
.sq-board-row.me {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.sq-board-rank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--header-chip-bg);
  font-size: 11px;
  font-weight: 800;
  color: var(--muted);
}
.sq-board-row.me .sq-board-rank { background: var(--accent); color: #fff; }
.sq-board-meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1 1 auto;
  min-width: 0;
}
.sq-board-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
}
.sq-board-xp { font-size: 11px; color: var(--muted); }
.sq-board-level {
  flex: 0 0 auto;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 3px 8px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent-strong);
}
.sq-board-row.me .sq-board-level { background: var(--accent); color: #fff; }
.sq-board-note {
  margin: 12px 4px 0;
  font-size: 11px;
  color: var(--muted);
  text-align: center;
}

.qq-xp {
  flex: 0 0 auto;
  font-size: 11px;
  font-weight: 800;
  color: var(--xp);
  border: 1px solid color-mix(in srgb, var(--xp) 45%, transparent);
  padding: 2px 8px;
  border-radius: 999px;
}
.qq-xp-earned {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 8px 10px;
  margin: 10px 4px 0;
  border: 1px dashed color-mix(in srgb, var(--xp) 55%, transparent);
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--xp) 8%, transparent);
  text-align: center;
}
.qq-xp-earned.perfect { border-style: solid; }
.qq-xp-amount { font-size: 14px; font-weight: 800; color: var(--xp); }
.qq-xp-bonus,
.qq-xp-total,
.qq-xp-up { font-size: 11.5px; color: var(--muted); }
.qq-xp-up { color: var(--ok); font-weight: 800; }

/* Difficulty filter above the rule catalog */
.sq-filter {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 2px 0 10px;
}
.sq-filter-chip {
  padding: 5px 12px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface);
  color: var(--muted);
  font-size: 11.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all var(--dur-fast) var(--ease);
}
.sq-filter-chip:hover { border-color: var(--accent); color: var(--accent-strong); }
.sq-filter-chip.selected {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}
.sq-filter-hint {
  margin: 10px 2px 0;
  font-size: 11px;
  color: var(--muted);
}

/* Per-rule difficulty badge */
.sq-row-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: auto;
}
.sq-diff-badge {
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.sq-diff-badge.easy { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); }
.sq-diff-badge.medium { background: color-mix(in srgb, var(--warn) 16%, transparent); color: var(--warn); }
.sq-diff-badge.hard { background: color-mix(in srgb, var(--err) 14%, transparent); color: var(--err); }

/* Achievements view */
.sq-achievement-summary {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 10px;
}
.sq-achievement-count {
  font-size: 13px;
  font-weight: 800;
  color: var(--ink);
}
.sq-ach-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.sq-ach {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
  opacity: 0.62;
}
.sq-ach.unlocked {
  opacity: 1;
  border-color: color-mix(in srgb, var(--xp) 45%, var(--border));
  background: color-mix(in srgb, var(--xp) 7%, var(--surface));
}
.sq-ach-icon { font-size: 18px; line-height: 1; }
.sq-ach.unlocked .sq-ach-icon { filter: saturate(1.3); }
.sq-ach-title { font-size: 12px; font-weight: 800; color: var(--ink); }
.sq-ach-desc { font-size: 10.5px; color: var(--muted); line-height: 1.35; }
.sq-ach-state { margin-top: 2px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
.sq-ach:not(.unlocked) .sq-ach-state { color: var(--muted); }
.sq-ach.unlocked .sq-ach-state { color: var(--xp); }

/* Achievement toast on the results panel */
.qq-ach-unlocked {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 10px 4px 0;
  padding: 8px 10px;
  border: 1px solid color-mix(in srgb, var(--xp) 45%, transparent);
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--xp) 9%, transparent);
}
.qq-ach-icon { font-size: 16px; }
.qq-ach-note { font-size: 11.5px; font-weight: 800; color: var(--xp); white-space: pre-line; }

/* ── Syntax-Tree Quiz ── */
.sq-stage {
  display: grid;
  grid-template-columns: auto 1fr auto;
  grid-template-areas: "num title count" "num blurb blurb";
  gap: 2px 10px;
  width: 100%;
  text-align: left;
  padding: 12px;
  margin: 8px 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: inherit;
  cursor: pointer;
}
.sq-stage:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, transparent); }
.sq-stage-alt { border-style: dashed; }
.sq-stage-num {
  grid-area: num; align-self: start;
  font-size: 10.5px; font-weight: 800; text-transform: uppercase;
  letter-spacing: .04em; color: var(--accent);
}
.sq-stage-title { grid-area: title; font-weight: 700; font-size: 14px; }
.sq-stage-count { grid-area: count; font-size: 11px; color: var(--muted); white-space: nowrap; }
.sq-stage-blurb { grid-area: blurb; font-size: 12px; color: var(--muted); line-height: 1.4; }

.sq-itemlist { margin-top: 12px; display: flex; flex-direction: column; gap: 2px; }
.sq-itemrow {
  display: flex; align-items: baseline; gap: 8px;
  padding: 4px 6px; border-radius: 5px;
}
.sq-itemrow:nth-child(odd) { background: color-mix(in srgb, var(--ink) 4%, transparent); }
.sq-itemtag {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px; font-weight: 700; color: var(--accent);
  min-width: 56px;
}
.sq-itemname { font-size: 12.5px; color: var(--muted); }
.sq-itemmore { padding: 6px; font-size: 12px; color: var(--muted); font-style: italic; }

.sq-q { font-size: 14px; font-weight: 600; line-height: 1.5; margin: 12px 0; }
.sq-opts { display: flex; flex-direction: column; gap: 6px; margin: 10px 0; }
.sq-opt {
  text-align: left; padding: 9px 12px;
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  background: transparent; color: inherit; cursor: pointer;
  font: inherit; font-size: 13px;
}
.sq-opt:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
.sq-input {
  width: 100%; padding: 9px 12px; margin: 6px 0;
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  background: transparent; color: inherit; font: inherit; font-size: 13px;
}
.sq-fb {
  margin: 12px 0; padding: 10px 12px;
  border-radius: var(--radius-sm); font-size: 13px; line-height: 1.4;
}
.sq-fb-ok { border: 1px solid color-mix(in srgb, var(--ok, #2e7d32) 45%, transparent); background: color-mix(in srgb, var(--ok, #2e7d32) 10%, transparent); }
.sq-fb-no { border: 1px solid color-mix(in srgb, var(--err) 45%, transparent); background: color-mix(in srgb, var(--err) 10%, transparent); }

/* ── Builder quiz: sentence challenges ── */
.sq-challenge {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  text-align: left;
  padding: 11px 12px;
  margin: 6px 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: transparent;
  color: inherit;
  cursor: pointer;
  font: inherit;
}
.sq-challenge:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, transparent); }
.sq-challenge.is-done { border-color: color-mix(in srgb, var(--ok, #2e7d32) 45%, transparent); }
.sq-challenge-mark {
  flex: none;
  width: 18px; height: 18px;
  display: grid; place-items: center;
  border-radius: 50%;
  font-size: 11px; font-weight: 800;
  color: var(--muted);
  background: color-mix(in srgb, var(--ink) 6%, transparent);
}
.sq-challenge.is-done .sq-challenge-mark { color: #fff; background: var(--ok, #2e7d32); }
.sq-challenge-sentence { font-size: 13px; font-weight: 600; }

.sq-start {
  display: inline-block;
  padding: 9px 16px;
  margin: 8px 0;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--accent-strong);
  color: #fff;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
}
.sq-start:hover { background: var(--accent); }
.sq-start:active { transform: scale(0.98); }

/* Builder status feedback in the bar */
.builder-hint-ok { color: var(--ok, #2e7d32); font-weight: 600; }
.builder-hint-no { color: var(--err); font-weight: 600; }

/* ── Builder quiz: table of contents + lesson ── */
.sq-group {
  margin: 16px 0 4px;
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--muted);
}
.sq-group:first-child { margin-top: 4px; }

.sq-rule {
  display: flex;
  gap: 10px;
  padding: 12px;
  margin: 8px 0 4px;
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--accent) 5%, transparent);
}
.sq-rule-tag {
  flex: none;
  align-self: flex-start;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
  font-weight: 800;
  color: var(--accent);
}
.sq-rule-text { margin: 0; font-size: 13px; line-height: 1.5; }
.sq-rule-body { min-width: 0; }
.sq-rule-detail { margin: 8px 0 0; font-size: 12.5px; line-height: 1.55; color: var(--muted); }

/* Step-by-step tree-building guide for the active example */
.sq-steps-box {
  padding: 12px;
  margin: 8px 0 4px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
}
.sq-steps-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; margin: 0 0 8px; }
.sq-steps-label {
  font-size: 9.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--accent-strong);
}
.sq-steps-sentence { font-size: 13px; font-weight: 700; color: var(--ink); }
/* Opens the interactive spotlight guide on this step (or stops it) */
.sq-steps-guide {
  margin-left: auto;
  padding: 4px 11px;
  border: 1px solid var(--accent);
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font: inherit;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: .02em;
  white-space: nowrap;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.sq-steps-guide:hover { background: var(--accent); color: #fff; }
.sq-steps { display: flex; flex-direction: column; gap: 7px; margin: 0; padding-left: 22px; }
/* Steps are clickable rows: the guide jumps to the step you pick */
.sq-steps li {
  font-size: 12.5px;
  line-height: 1.5;
  cursor: pointer;
  border-radius: 6px;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.sq-steps li:hover { background: var(--accent-soft); }
.sq-steps li.is-current { background: var(--accent-soft); color: var(--accent-strong); font-weight: 600; }
.sq-steps li::marker { color: var(--accent-strong); font-weight: 800; }

/* Active row in the Practice page's example list */
.sq-challenge.is-active {
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 9%, transparent);
}

/* ------------------------------------------------------------------ */
/* Lessons overlay — full-workspace frosted catalog, one page at a time */
/* ------------------------------------------------------------------ */
.lessons-overlay {
  position: fixed;
  top: 0;
  /* Starts right of the docked rail (0 on mobile, where the drawer is closed). */
  left: var(--rail-w, 0px);
  right: 0;
  bottom: 0;
  z-index: 190;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14px 18px;
  overflow: hidden;
  background: rgba(15, 17, 23, 0.45);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--dur) var(--ease), visibility 0s linear var(--dur);
}
.lessons-overlay.open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: opacity var(--dur) var(--ease);
}
[data-theme="dark"] .lessons-overlay { background: rgba(8, 10, 16, 0.62); }

.lessons-sheet {
  width: min(1280px, 100%);
  height: 100%;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  gap: 16px;
  overflow: hidden;
  transform: translateY(8px);
  transition: transform var(--dur) var(--ease);
}
.lessons-overlay.open .lessons-sheet { transform: none; }

.lessons-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}
.lessons-title { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.01em; color: #fff; }
.lessons-summary { margin: 4px 0 0; font-size: 12.5px; color: rgba(255, 255, 255, 0.7); }
.lessons-close {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.lessons-close:hover { background: rgba(255, 255, 255, 0.24); border-color: rgba(255, 255, 255, 0.55); }
.lessons-close:active { transform: scale(0.94); }

.lessons-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
.lessons-tab {
  padding: 7px 18px;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 999px;
  background: transparent;
  color: rgba(255, 255, 255, 0.82);
  font: inherit;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
}
.lessons-tab:hover { background: rgba(255, 255, 255, 0.12); color: #fff; }
.lessons-tab.is-active { background: var(--panel); color: var(--ink); border-color: transparent; box-shadow: var(--shadow-sm); }
[data-theme="dark"] .lessons-tab.is-active {
  background: var(--accent-soft);
  color: var(--accent-strong);
  border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  box-shadow: none;
}

.lessons-grid {
  flex: 1 1 auto;
  min-height: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  align-content: center;
  align-content: safe center;
  overflow: hidden;
}

.lesson-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  min-height: 172px;
  padding: 16px 18px 18px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--panel);
  color: var(--ink);
  font: inherit;
  text-align: left;
  cursor: pointer;
  transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.lesson-card:hover { border-color: var(--accent); box-shadow: var(--shadow-sm); transform: translateY(-1px); }
.lesson-card:active { transform: translateY(0); }
.lesson-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.lesson-badge {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.04em;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
  color: var(--accent-strong);
  background: var(--accent-soft);
}
.lesson-card-title { font-size: 19px; font-weight: 800; letter-spacing: -0.3px; line-height: 1.25; }
.lesson-card-overview {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
  font-size: 12px;
  line-height: 1.5;
  color: var(--muted);
}
.lesson-card-count { margin-top: auto; font-size: 11.5px; color: var(--muted); }

.lesson-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; }
.lesson-bar-fill { display: block; height: 100%; width: 0; background: var(--accent); transition: width var(--dur) var(--ease); }
.lesson-card.is-complete .lesson-bar-fill { background: var(--ok); }

.lessons-foot { display: flex; justify-content: center; }
.lessons-free {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  border: 1px dashed rgba(255, 255, 255, 0.28);
  border-radius: 999px;
  background: transparent;
  color: rgba(255, 255, 255, 0.75);
  font: inherit;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.lessons-free:hover { color: #fff; border-color: rgba(255, 255, 255, 0.55); background: rgba(255, 255, 255, 0.08); }

/* ------------------------------------------------------------------ */
/* Active lesson — controls in #quizQuestHost, page in #lessonGuideHost */
/* ------------------------------------------------------------------ */
.sq-lesson { flex: 0 0 auto; min-width: 0; display: flex; flex-direction: column; gap: 10px; }

/* Lesson title sized for its slot above the pager (scoped so the base
   `.sq-title` — sidebar quiz views — stays small). Wrapping beats
   ellipsizing at narrow pane widths. */
.sq-lesson .sq-title {
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -0.2px;
  line-height: 1.3;
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
}
.sq-lesson-nav { flex: 0 0 auto; display: flex; gap: 8px; }
.sq-lesson-nav .sq-ghost { margin: 0; flex: 0 0 auto; }
.sq-lesson-nav .sq-primary { margin: 0; flex: 1 1 auto; }
.sq-lesson-nav .sq-ghost:disabled { opacity: .45; cursor: not-allowed; }
.sq-lesson-nav .sq-ghost, .sq-lesson-nav .sq-primary { padding: 9px 12px; font-size: 12.5px; }

.sq-lesson-body .sq-rule,
.sq-lesson-body .sq-steps-box,
.sq-lesson-body .sq-challenge { margin: 0; }
.sq-lesson-body .sq-group { margin: 0; }

/* The page body lives in the scrollable #lessonGuideHost card, so the
   content may breathe: larger type than the old fixed-height wizard. */
.sq-lesson-body { flex: 0 0 auto; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
.sq-lesson-body .sq-rule { padding: 12px; }
.sq-lesson-body .sq-rule-text { font-size: 13.5px; line-height: 1.5; }
.sq-lesson-body .sq-rule-detail { margin-top: 8px; font-size: 12.5px; line-height: 1.55; }
.sq-lesson-body .sq-steps li { font-size: 13px; line-height: 1.55; }

.sq-lessons-back {
  align-self: flex-start;
  padding: 3px 9px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: transparent;
  color: var(--muted);
  font: inherit;
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
}
.sq-lessons-back:hover { color: var(--accent-strong); border-color: var(--accent); background: var(--accent-soft); }

.sq-pager { display: flex; gap: 6px; }
.sq-pager-pill {
  flex: 1 1 0;
  min-width: 0;
  padding: 4px 8px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: transparent;
  color: var(--muted);
  font: inherit;
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
  cursor: pointer;
  transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
}
.sq-pager-pill:hover { color: var(--accent-strong); border-color: var(--accent); }
.sq-pager-pill.is-active { color: var(--accent-strong); background: var(--accent-soft); border-color: var(--accent); }

.sq-example-pills { flex: 0 0 auto; display: flex; gap: 6px; }
.sq-example-pill {
  width: 26px;
  height: 26px;
  border: 1px solid var(--border);
  border-radius: 50%;
  background: var(--surface);
  color: var(--muted);
  font: inherit;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
}
.sq-example-pill:hover { border-color: var(--accent); color: var(--accent-strong); }
.sq-example-pill.is-done { border-color: var(--ok); color: var(--ok); }
.sq-example-pill.is-active { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-strong); }

/* ------------------------------------------------------------------ */
/* Lesson quiz page — the module's only quiz, at the very end          */
/* ------------------------------------------------------------------ */
.sq-quiz-summary {
  padding: 10px;
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--accent) 5%, transparent);
}
.sq-quiz-summary p { margin: 0; font-size: 12px; line-height: 1.5; }
.sq-quiz-list { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; list-style: none; }
.sq-quiz-item {
  display: flex;
  align-items: baseline;
  gap: 8px;
  padding: 7px 9px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
  font-size: 12px;
}
.sq-quiz-mark { flex: 0 0 auto; font-weight: 800; color: var(--muted); }
.sq-quiz-mark.is-done { color: var(--ok); }
.sq-quiz-sent { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ------------------------------------------------------------------ */
/* Interactive step guide — spotlight ring + tooltip over the canvas   */
/* ------------------------------------------------------------------ */
/* The layer never intercepts pointer events (the learner must be able to
   right-click and drag on the canvas while following a step); only the
   tooltip card itself is interactive. Sits above the canvas/pane chrome
   but below the right-click menu (z 60), the sidebar rail (z 195), the
   lessons overlay (z 190) and modals (z 300). */
.step-guide {
  position: fixed;
  inset: 0;
  z-index: 29;
  pointer-events: none;
}
.step-guide[hidden] { display: none; }
.step-guide-ring {
  position: fixed;
  border: 2px solid var(--accent);
  border-radius: 10px;
  box-shadow:
    0 0 0 9999px rgba(15, 17, 23, 0.3),
    0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
}
[data-theme="dark"] .step-guide-ring {
  box-shadow:
    0 0 0 9999px rgba(4, 6, 12, 0.45),
    0 0 0 3px color-mix(in srgb, var(--accent) 24%, transparent);
}
.step-guide-card {
  position: fixed;
  width: min(300px, calc(100vw - 24px));
  padding: 12px 14px 14px;
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  background: var(--panel);
  color: var(--ink);
  box-shadow: var(--shadow-md);
  pointer-events: auto;
}
.step-guide-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
.step-guide-kicker {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .07em;
  color: var(--accent-strong);
}
.step-guide-close {
  flex: 0 0 auto;
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: var(--muted);
  font-size: 16px;
  line-height: 1;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.step-guide-close:hover { background: var(--accent-soft); color: var(--accent-strong); }
.step-guide-text { margin: 0; font-size: 12.5px; line-height: 1.5; }
.step-guide-nav { display: flex; gap: 8px; margin-top: 12px; }
.step-guide-nav .sq-ghost, .step-guide-nav .sq-primary { margin: 0; flex: 1 1 auto; padding: 7px 10px; font-size: 12px; }

/* Narrow screens keep three columns unless there is height for a third row */
@media (max-width: 1020px) {
  .lesson-card-overview { -webkit-line-clamp: 3; }
}
@media (max-width: 1020px) and (min-height: 820px) {
  .lessons-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 760px) {
  .lessons-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .lesson-card { min-height: 0; }
  .lesson-card-overview { -webkit-line-clamp: 2; }
}
@media (max-width: 520px) {
  .lessons-overlay { padding: 10px; }
  .lessons-title { font-size: 18px; }
  .lessons-tab { padding: 6px 12px; font-size: 11.5px; }
  .lesson-card-title { font-size: 17px; }
}
@media (max-height: 620px) {
  .lessons-overlay { padding: 10px 14px; }
  .lessons-sheet { gap: 10px; }
  .lesson-card { min-height: 140px; padding: 12px 14px 14px; }
  .lesson-card-title { font-size: 18px; }
  .lesson-card-overview { -webkit-line-clamp: 2; }
}
