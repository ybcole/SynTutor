    "10.7": [
      {"bad":"The family planned a trip abroad. we visited paris in july. The city was warm and busy. my sister loved the eiffel tower. We took hundreds of photos.","good":"The family planned a trip abroad. We visited Paris in July. The city was warm and busy. My sister loved the Eiffel Tower. We took hundreds of photos.","explanation":"Capitalise the first word, names of places, and months.","sentences":[{"bad":"The family planned a trip abroad.","good":"The family planned a trip abroad."},{"bad":"we visited paris in july.","good":"We visited Paris in July."},{"bad":"The city was warm and busy.","good":"The city was warm and busy."},{"bad":"my sister loved the eiffel tower.","good":"My sister loved the Eiffel Tower."},{"bad":"We took hundreds of photos.","good":"We took hundreds of photos."}]},
      {"bad":"The pupils studied world geography. they learned about the river nile. The lesson was fascinating. on monday they studied the alps. The class asked many questions.","good":"The pupils studied world geography. They learned about the River Nile. The lesson was fascinating. On Monday they studied the Alps. The class asked many questions.","explanation":"Capitalise proper nouns, days and specific place names.","sentences":[{"bad":"The pupils studied world geography.","good":"The pupils studied world geography."},{"bad":"they learned about the river nile.","good":"They learned about the River Nile."},{"bad":"The lesson was fascinating.","good":"The lesson was fascinating."},{"bad":"on monday they studied the alps.","good":"On Monday they studied the Alps."},{"bad":"The class asked many questions.","good":"The class asked many questions."}]},
      {"bad":"The choir practised a new song. they sang a piece by mozart. The concert was in december. the choir travelled to london for it. The performance was beautiful.","good":"The choir practised a new song. They sang a piece by Mozart. The concert was in december. The choir travelled to London for it. The performance was beautiful.","explanation":"Capitalise names of people, months and cities.","sentences":[{"bad":"The choir practised a new song.","good":"The choir practised a new song."},{"bad":"they sang a piece by mozart.","good":"They sang a piece by Mozart."},{"bad":"The concert was in december.","good":"The concert was in december."},{"bad":"the choir travelled to london for it.","good":"The choir travelled to London for it."},{"bad":"The performance was beautiful.","good":"The performance was beautiful."}]},
      {"bad":"The book club met on friday. they discussed a novel by dickens. Everyone had read the first chapter. the next meeting is in october. They chose a new title to read.","good":"The book club met on friday. They discussed a novel by Dickens. Everyone had read the first chapter. The next meeting is in October. They chose a new title to read.","explanation":"Capitalise the sentence start, author names and months.","sentences":[{"bad":"The book club met on friday.","good":"The book club met on friday."},{"bad":"they discussed a novel by dickens.","good":"They discussed a novel by Dickens."},{"bad":"Everyone had read the first chapter.","good":"Everyone had read the first chapter."},{"bad":"the next meeting is in october.","good":"The next meeting is in October."},{"bad":"They chose a new title to read.","good":"They chose a new title to read."}]},
      {"bad":"The tourists crossed the border. they arrived in italy on tuesday. The weather was perfect for sightseeing. they visited rome and florence. The holiday was unforgettable.","good":"The tourists crossed the border. They arrived in Italy on Tuesday. The weather was perfect for sightseeing. They visited Rome and Florence. The holiday was unforgettable.","explanation":"Capitalise countries, cities and days of the week.","sentences":[{"bad":"The tourists crossed the border.","good":"The tourists crossed the border."},{"bad":"they arrived in italy on tuesday.","good":"They arrived in Italy on Tuesday."},{"bad":"The weather was perfect for sightseeing.","good":"The weather was perfect for sightseeing."},{"bad":"they visited rome and florence.","good":"They visited Rome and Florence."},{"bad":"The holiday was unforgettable.","good":"The holiday was unforgettable."}]}
