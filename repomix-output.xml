  --header-chip-border: rgba(15, 23, 42, 0.12);
  --empty-icon: #a0aec0;
  --focus-ring: color-mix(in srgb, var(--accent) 22%, transparent);
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.14);
  --shadow-lg: 0 24px 70px rgba(0, 0, 0, 0.28);
  --ease: cubic-bezier(0.33, 0.6, 0.4, 1);
  --dur-fast: 0.2s;
