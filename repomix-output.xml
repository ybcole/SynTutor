}

.app-shell {
  flex: 1 1 auto;
  min-height: 0;
  height: 100vh;
  overflow: hidden;
  display: grid;
  /* Column 1 is the docked sidebar rail (via #appSidebarBackdrop, a plain
     grid wrapper on desktop — see quiz.css) plus the left sub-panels that
     slide out beside it; column 2 is the whole workspace (.app-main). */
  grid-template-columns: auto minmax(0, 1fr);
  grid-template-rows: minmax(0, 1fr);
  /* Rail width, so fixed overlays (the Lessons picker) stop clear of it;
     sub-panels widen the column while open (desktop only, below). */
  --rail-w: 60px;
