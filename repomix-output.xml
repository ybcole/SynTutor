/* Left slide-out sub-panels (History + the tree-quiz panel). Base styles are
   the small-screen behaviour: a fixed full-screen dim backdrop with the panel
   sliding in from the left edge. On desktop (min-width: 761px, below) both
   become static flex children of the shell's rail column — width 0 → 336px,
   so the workspace grid shifts instead of being covered. */
.drawer-backdrop,
.side-subpanel {
  position: fixed;
  inset: 0;
  z-index: 210;
  display: flex;
  background: rgba(20, 16, 36, 0.4);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--dur) var(--ease), visibility var(--dur) var(--ease);
}
.drawer-backdrop.active,
