.hist-delete-btn:hover {
  color: var(--err);
  background: color-mix(in srgb, var(--err) 10%, transparent);
}
.hist-delete-btn:active {
  transform: scale(0.92);
}
.hist-delete-btn:disabled {
  cursor: default;
  transform: none;
}
.history-empty {
  margin: 0;
  padding: 30px 12px;
  text-align: center;
  font-size: 13px;
  color: var(--muted);
}

.app-main {
  grid-column: 2;
  grid-row: 1;
  min-height: 0;
  min-width: 0;
  display: grid;
  /* Canvas column | 8px gutter | right column; the split is a percentage
     var written by the #colResizer drag handler. */
  grid-template-columns: minmax(0, var(--col-split, 58%)) 8px minmax(0, 1fr);
  column-gap: 12px;
  padding: 10px 18px 8px;
}

/* ── Draggable gutters between the panes ── */
/* The gutter is a transparent 8px track with a small pill indicator that
   turns accent-colored on hover / while dragging (see .resizer::after). */
.resizer {
  position: relative;
  z-index: 5;
  align-self: stretch;
  justify-self: center;
  touch-action: none;
  background: transparent;
  border: none;
  padding: 0;
}
.resizer::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 999px;
  background: color-mix(in srgb, var(--muted) 45%, transparent);
  transition: background var(--dur-fast) var(--ease), width var(--dur-fast) var(--ease), height var(--dur-fast) var(--ease);
}
.resizer:hover::after,
.resizer.dragging::after {
  background: var(--accent);
}
.resizer-col { cursor: col-resize; width: 100%; }
.resizer-col::after { width: 3px; height: 46px; }
.resizer-col.dragging::after { height: 72px; }
.resizer-row {
  cursor: row-resize;
  align-self: center;
  width: 100%;
  height: 8px;
}
.resizer-row::after { width: 46px; height: 3px; }
.resizer-row.dragging::after { width: 72px; }
body.is-resizing { user-select: none; -webkit-user-select: none; }

/* Right column: the input pane over the explain pane, split by #rowResizer. */
.pane-side {
  min-height: 0;
  min-width: 0;
  display: grid;
  grid-template-rows: minmax(0, var(--row-split, 58%)) 8px minmax(0, 1fr);
  row-gap: 12px;
}
.pane {
  min-height: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.pane-input {
  padding: 12px 16px 14px;
  background: var(--panel);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
/* The explain pane is a plain slot; its children (#lessonGuideHost and the
   node inspector) are the cards. */
.pane-explain { overflow: visible; }

/* Lesson controls (#quizQuestHost) and page content (#lessonGuideHost) are
   rendered by tree-quiz.js; when empty they must not reserve card chrome. */
#quizQuestHost:empty,
#lessonGuideHost:empty { display: none; }
#lessonGuideHost {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
}
/* Every pane in the new layout scrolls, so tint the native Firefox
   scrollbars (scrollbar-color; Chromium already has the ::-webkit-* rules
   above) instead of the UA default — a white track is glaring in dark mode. */
#lessonGuideHost,
#quizQuestHost,
.pane-input,
.node-explainer,
.side-subpanel,
.history-drawer {
  scrollbar-color: color-mix(in srgb, var(--muted) 45%, transparent) transparent;
}
/* While a lesson is open but no node is picked, the lesson guide owns the
   whole explain pane; picking a canvas node brings the inspector back
   underneath it. */
body:has(#lessonGuideHost:not(:empty)) .primary-explainer:has(#emptyExplainState:not(.hidden)) {
  display: none;
}

.card {
  background: var(--panel);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  padding: 16px;
  box-shadow: var(--shadow-sm);
  min-width: 0;
}

.card h3 {
  margin: 0 0 10px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.3px;
  color: var(--ink);
}

.card h4 {
  margin: 0 0 10px;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--accent);
}

.card p {
  line-height: 1.55;
}

.card p:not(.ex-text):not(.muted) {
  font-size: 12.5px;
  color: var(--ink);
}

.canvas-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 0;
  min-width: 0;
  background: var(--panel);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.canvas-stage {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
}
#treeCanvas { width: 100%; height: 100%; display: block; cursor: grab; }
#treeCanvas[hidden], .builder-canvas[hidden] { display: none; }
#treeCanvas:hover { cursor: grab; }
#treeCanvas:active { cursor: grabbing; }
#treeCanvas:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: -2px;
}

.empty-state-canvas {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 2;
  text-align: center;
}
.empty-state-canvas.hidden { display: none; }
.empty-tree-icon {
  width: 72px;
  height: 72px;
  color: var(--empty-icon);
  margin-bottom: 14px;
}
.empty-tree-title {
  font-size: 15.5px;
  font-weight: 600;
  color: var(--ink);
  margin: 0 0 6px;
}
.empty-tree-sub {
  font-size: 12.5px;
  color: var(--muted);
  margin: 0;
}

.primary-explainer {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  position: relative;
  padding: 20px;
}

/* Node inspection shares the explain pane with the lesson guide: the guide
   sits on top, the inspector fills what is left (and is hidden outright
   while the guide has content and nothing is selected — see above). */
.node-explainer { flex: 1 1 auto; min-height: 0; overflow-y: auto; }

.empty-state-explain {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  text-align: center;
}
.empty-state-explain.hidden { display: none; }
.empty-book-icon {
  width: 60px;
  height: 60px;
  color: var(--empty-icon);
  margin-bottom: 12px;
}
.empty-explain-title {
  font-size: 14.5px;
  font-weight: 500;
  color: var(--muted);
  margin: 0;
}

.canvas-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  background: rgba(244, 243, 251, 0.25);
  overflow-y: auto;
  padding: 16px;
  z-index: 10;
}
[data-theme="dark"] .canvas-overlay {
  background: rgba(15, 17, 23, 0.35);
}
.canvas-overlay:empty { background: transparent; }

.loading-pill {
  position: absolute;
  top: 18px;
  left: 50%;
  z-index: 12;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 16px;
  border-radius: 999px;
  background: var(--panel);
  border: 1px solid var(--card-border);
  box-shadow: var(--shadow-md);
  font-size: 12.5px;
  font-weight: 600;
  color: var(--ink);
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transform: translate(-50%, -6px);
  transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease), visibility var(--dur) var(--ease);
}
.loading-pill.visible {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0);
}
.loading-spinner {
  width: 13px;
  height: 13px;
  flex: 0 0 auto;
  border-radius: 50%;
  border: 2px solid color-mix(in srgb, var(--accent) 25%, transparent);
  border-top-color: var(--accent);
  animation: loading-spin 0.75s linear infinite;
}
@keyframes loading-spin {
  to { transform: rotate(360deg); }
}
.overlay-card {
  max-width: 480px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  box-shadow: var(--shadow-md);
}
.overlay-card h3 {
  margin: 0 0 8px;
  color: var(--ink);
  font-size: 15px;
  font-weight: 700;
}
.overlay-card p { margin: 6px 0; font-size: 13px; line-height: 1.5; }
.overlay-card.error { border-color: var(--err); }
.overlay-card.error h3 { color: var(--err); }

.menu-btn[hidden] { display: none; }
.menu-btn.open {
  background: var(--header-hover);
}
.menu-btn svg {
  transition: transform var(--dur) var(--ease);
}
.menu-btn.open svg {
  transform: rotate(180deg);
}

.node-card {
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--panel);
}
.nc-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
.nc-dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
.nc-dot.ok { background: var(--ok); }
.nc-dot.err { background: var(--err); }
.nc-dot.un { background: var(--warn); }
.nc-name { font-size: 15px; font-weight: 700; color: var(--ink); }
.nc-surface { font-size: 12.5px; color: var(--muted); font-style: italic; }
.nc-chiprow { margin: 0 0 12px; display: flex; gap: 8px; flex-wrap: wrap; }
.nc-chip { font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); border: 1px solid var(--border); }
.nc-chip.err {
  background: color-mix(in srgb, var(--err) 12%, transparent);
  color: var(--err);
  border-color: color-mix(in srgb, var(--err) 30%, transparent);
}
.nc-label { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--muted); font-weight: 700; margin: 14px 0 5px; }
.ex-text { font-size: 13px; line-height: 1.6; color: var(--ink); margin: 0; }
.nc-rem { margin-top: 4px; }
.nc-fix { color: var(--ok); }
.muted { color: var(--muted); font-size: 12.5px; }

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 17, 23, 0.55);
  padding: 16px;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--dur) var(--ease), visibility var(--dur) var(--ease);
}
.modal-backdrop.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}
.auth-modal {
  width: 100%;
  max-width: 380px;
  background: var(--panel);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  padding: 20px;
  transform: translateY(12px) scale(0.98);
  transition: transform var(--dur) var(--ease);
}
.modal-backdrop.active .auth-modal {
  transform: none;
}
.auth-modal-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.modal-input {
  width: 100%;
  height: 40px;
  padding: 0 2px;
  border: none;
  border-bottom: 1px solid var(--border);
  border-radius: 0;
  font-size: 13.5px;
  background: transparent;
  color: var(--ink);
  outline: none;
  transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.modal-input::placeholder {
  color: var(--muted);
  opacity: 1;
}
.modal-input:hover {
  border-bottom-color: color-mix(in srgb, var(--border) 60%, var(--ink));
}
.modal-input:focus {
  border-bottom-color: var(--accent);
  box-shadow: 0 2px 10px -3px color-mix(in srgb, var(--accent) 55%, transparent);
}
.modal-input:focus-visible {
  outline: none;
}
.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 2px;
}
.modal-btn-primary {
  height: 40px;
  border: none;
  border-radius: 8px;
  background: var(--accent);
  color: #ffffff;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.modal-btn-primary:hover { background: var(--accent-strong); }
.modal-btn-primary:active { transform: scale(0.99); }
.modal-btn-secondary {
  height: 34px;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.modal-btn-secondary:hover { background: var(--accent-soft); color: var(--accent); }
.modal-close-row {
  display: flex;
  justify-content: center;
  margin-top: 8px;
  padding-top: 12px;
  border-top: 1px solid var(--border);
}
.modal-close-row[hidden] { display: none; }
.modal-ghost-btn {
  background: none;
  border: none;
  color: var(--muted);
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  padding: 6px 8px;
  border-radius: 6px;
  transition: color var(--dur-fast) var(--ease);
}
.modal-ghost-btn:hover { color: var(--accent); }
.msg { font-size: 12.5px; margin-top: 2px; min-height: 18px; }
.msg.err { color: var(--err); }
.msg.ok { color: var(--ok); }

.password-reqs[hidden] { display: none; }
.password-reqs {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin: -4px 0 2px;
  padding: 6px 8px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--header-chip-bg);
  font-size: 11px;
  line-height: 1.5;
  color: var(--muted);
}
.pw-req { white-space: nowrap; }
.pw-req.ok { color: var(--ok); font-weight: 600; }
.pw-req.missing { color: var(--err); font-weight: 600; }
.pw-req.soft { color: var(--muted); }

.password-field { position: relative; }
.password-field input { padding-right: 40px; }
.password-field .password-toggle {
  position: absolute;
  top: 50%;
  right: 8px;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  padding: 0;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
}
.password-field .password-toggle:hover { color: var(--ink); background: var(--header-hover); }
.password-toggle .eye-off { display: none; }
.password-toggle.shown .eye-open { display: none; }
.password-toggle.shown .eye-off { display: block; }

@media (max-width: 1400px) {
  .dev-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 900px) {
  .dev-grid { grid-template-columns: 1fr; }
}
@media (max-width: 760px) {
  body { overflow: auto; }
  /* No docked rail on small screens: the shell scrolls and the sidebar is
     a slide-over drawer again (#appSidebarBackdrop). */
  .app-shell {
    display: flex;
    flex-direction: column;
    height: auto;
    min-height: 100vh;
    overflow: visible;
    --rail-w: 0px;
  }
  .app-shell:has(.app-sidebar.expanded) { --rail-w: 0px; }
  .mobile-nav-btn {
    display: flex;
    position: relative;
    z-index: 196;
    margin-left: -6px;
  }
  /* Keep the hamburger usable while the full-screen Lessons overlay is open. */
  body.lessons-overlay-open .mobile-nav-btn { visibility: visible; }
  /* Inside the narrow drawer the account menu opens upward, within it. */
  .profile-menu { left: 0; }
  /* The workspace stacks vertically: canvas, then input, then explain pane.
     Drag gutters are a desktop-only affordance. */
  .app-main {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 10px 12px 8px;
  }
  .resizer { display: none; }
  .canvas-wrap { min-height: 42vh; }
  .pane-side {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pane-explain { min-height: 280px; }
}
/* ── Syntax Builder ── */
:root {
  --builder-grid: color-mix(in srgb, var(--ink) 12%, transparent);
  --builder-edge: color-mix(in srgb, var(--ink) 42%, transparent);
  --builder-phrase-bg: #e8ecff;
  --builder-phrase-border: #b8c2e8;
  --builder-phrase-ink: #243a8a;
  --builder-word-bg: #ffffff;
  --builder-word-border: #c9d2e0;
  --builder-word-ink: #1c2536;
  --builder-dot: #4c6fff;
  --builder-sel: #4c6fff;
  --builder-hover: #8aa0ff;
  --builder-muted: #8a94a6;
  --builder-danger: #e5484d;
  --builder-danger-bg: #fdecec;
}
[data-theme="dark"] {
  --builder-phrase-bg: #232a44;
  --builder-phrase-border: #3b4a7a;
  --builder-phrase-ink: #b9c6ff;
  --builder-word-bg: #1c2233;
  --builder-word-border: #39415a;
  --builder-word-ink: #e6eaf2;
  --builder-danger-bg: #3a1f22;
}

.builder-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  padding: 8px 12px;
  border-bottom: 1px solid var(--border);
  background: var(--surface);
  font-size: 13px;
}
.builder-bar[hidden] { display: none; }
.builder-title { font-weight: 700; }
.builder-hint { color: var(--muted); flex: 1 1 220px; min-width: 120px; }
.builder-target {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12.5px;
  padding: 3px 8px;
  border: 1px solid var(--border);
  border-radius: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 46%;
}
.builder-target-ok {
  border-color: color-mix(in srgb, var(--ok, #2e7d32) 55%, transparent);
  background: color-mix(in srgb, var(--ok, #2e7d32) 12%, transparent);
}
.builder-spacer { flex: 1 1 auto; }
.builder-btn {
  font: inherit; font-size: 12.5px; padding: 6px 12px; cursor: pointer;
  border: 1px solid var(--border, #ccc); border-radius: 6px;
  background: transparent; color: inherit;
}
.builder-btn:hover { border-color: var(--accent); }
.builder-btn-primary {
  background: var(--accent, #6d5ae6); border-color: var(--accent, #6d5ae6);
  color: #fff;
}
.builder-btn-primary:hover { background: var(--accent-strong, var(--accent)); }

.builder-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  touch-action: none;
  cursor: default;
}

/* Transient feedback toast shown over the canvas during a quiz */
.builder-toast {
  position: absolute;
  left: 50%;
  bottom: 24px;
  transform: translate(-50%, 12px);
  padding: 8px 16px;
  border-radius: 999px;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--ink);
  font-size: 13px;
  font-weight: 600;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease, transform 0.18s ease;
  z-index: 40;
}
.builder-toast.show {
  opacity: 1;
  transform: translate(-50%, 0);
}
.builder-toast-ok {
  border-color: var(--ok);
  color: var(--ok);
}
.builder-toast-no {
  border-color: var(--err);
  color: var(--err);
}

/* Bare, chrome-less text entry on the canvas */
.builder-inline-input {
  position: absolute;
  z-index: 30;
  min-width: 40px;
  padding: 0;
  border: 0;
  outline: none;
  background: transparent;
  color: var(--ink);
  font: inherit;
  font-size: 14px;
  text-align: center;
}

/* Right-click node menu */
.builder-menu {
  position: fixed;
  z-index: 60;
  width: 248px;
  max-height: 360px;
  display: flex;
  flex-direction: column;
  background: var(--surface, #fff);
  border: 1px solid var(--border, #ccc);
  border-radius: 8px;
  box-shadow: 0 10px 34px rgba(0,0,0,.22);
  overflow: hidden;
  font-size: 13px;
}
.builder-menu-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 10px;
  border-bottom: 1px solid var(--border, #ccc);
}
.builder-menu-title {
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .04em; color: var(--muted, #888);
}
.builder-menu-delete {
  font: inherit; font-size: 11.5px; padding: 3px 8px; cursor: pointer;
  border: 1px solid color-mix(in srgb, var(--err) 45%, transparent);
  border-radius: 6px;
  background: transparent;
  color: var(--err);
}
.builder-menu-delete:hover { background: color-mix(in srgb, var(--err) 12%, transparent); }
.builder-menu-search {
  font: inherit; font-size: 13px; padding: 8px 10px;
  border: 0; border-bottom: 1px solid var(--border, #ccc);
  background: transparent; color: inherit; outline: none;
}
.builder-menu-scroll { overflow-y: auto; padding: 4px; }
.builder-menu-grid { display: flex; flex-direction: column; }
.builder-menu-empty {
  padding: 10px; font-size: 12px; color: var(--muted, #888); font-style: italic;
}
.builder-menu-item {
  display: block; width: 100%; text-align: left;
  font: inherit; font-size: 13px; font-weight: 600;
  padding: 5px 9px; border: 0; border-radius: 5px;
  background: transparent; color: inherit; cursor: pointer;
}
