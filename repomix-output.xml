    "8.5": [
      {"bad":"My sister is a talented pupil. She is very good in maths. She solves problems quickly. She is also interested on science. She hopes to study engineering.","good":"My sister is a talented pupil. She is very good at maths. She solves problems quickly. She is also interested in science. She hopes to study engineering.","explanation":"Use \"good at\" and \"interested in\".","sentences":[{"bad":"My sister is a talented pupil.","good":"My sister is a talented pupil."},{"bad":"She is very good in maths.","good":"She is very good at maths."},{"bad":"She solves problems quickly.","good":"She solves problems quickly."},{"bad":"She is also interested on science.","good":"She is also interested in science."},{"bad":"She hopes to study engineering.","good":"She hopes to study engineering."}]},
      {"bad":"The team was well prepared. They were confident of winning the final. The coach trusted the players. They were capable for a strong performance. The match went to extra time.","good":"The team was well prepared. They were confident of winning the final. The coach trusted the players. They were capable of a strong performance. The match went to extra time.","explanation":"Use \"capable of\" and \"confident of\".","sentences":[{"bad":"The team was well prepared.","good":"The team was well prepared."},{"bad":"They were confident of winning the final.","good":"They were confident of winning the final."},{"bad":"The coach trusted the players.","good":"The coach trusted the players."},{"bad":"They were capable for a strong performance.","good":"They were capable of a strong performance."},{"bad":"The match went to extra time.","good":"The match went to extra time."}]},
      {"bad":"The town became very popular. Visitors are fond for its old market. The market sells local food. People are proud for the market's history. It has stood there for centuries.","good":"The town became very popular. Visitors are fond of its old market. The market sells local food. People are proud of the market's history. It has stood there for centuries.","explanation":"Use \"fond of\" and \"proud of\".","sentences":[{"bad":"The town became very popular.","good":"The town became very popular."},{"bad":"Visitors are fond for its old market.","good":"Visitors are fond of its old market."},{"bad":"The market sells local food.","good":"The market sells local food."},{"bad":"People are proud for the market's history.","good":"People are proud of the market's history."},{"bad":"It has stood there for centuries.","good":"It has stood there for centuries."}]},
      {"bad":"The pupil borrowed a book. She was grateful of the help. The librarian found it quickly. The book was full with pictures. She read it in two days.","good":"The pupil borrowed a book. She was grateful for the help. The librarian found it quickly. The book was full of pictures. She read it in two days.","explanation":"Use \"grateful for\" and \"full of\".","sentences":[{"bad":"The pupil borrowed a book.","good":"The pupil borrowed a book."},{"bad":"She was grateful of the help.","good":"She was grateful for the help."},{"bad":"The librarian found it quickly.","good":"The librarian found it quickly."},{"bad":"The book was full with pictures.","good":"The book was full of pictures."},{"bad":"She read it in two days.","good":"She read it in two days."}]},
      {"bad":"The workers finished the job. They were proud for the finished bridge. The bridge crosses a wide river. It is famous with its long span. Tourists photograph it every day.","good":"The workers finished the job. They were proud of the finished bridge. The bridge crosses a wide river. It is famous for its long span. Tourists photograph it every day.","explanation":"Use \"proud of\" and \"famous for\".","sentences":[{"bad":"The workers finished the job.","good":"The workers finished the job."},{"bad":"They were proud for the finished bridge.","good":"They were proud of the finished bridge."},{"bad":"The bridge crosses a wide river.","good":"The bridge crosses a wide river."},{"bad":"It is famous with its long span.","good":"It is famous for its long span."},{"bad":"Tourists photograph it every day.","good":"Tourists photograph it every day."}]}
