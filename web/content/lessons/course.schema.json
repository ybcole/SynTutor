          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "course_version",
    "title",
    "tracks",
    "sources",
    "lessons",
    "planned_modules",
    "concepts"
