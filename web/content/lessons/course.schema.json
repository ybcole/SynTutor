                }
              },
              "required": [
                "text",
                "source_ids",
                "concept_ids"
              ]
            }
          },
          "completion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required_stages": {
                "const": [
                  "predict",
                  "understand",
                  "worked",
                  "guided",
                  "transfer",
                  "exit"
                ]
              },
              "required_correct": {
                "const": [
                  "guided",
                  "transfer",
                  "exit"
                ]
              },
              "reward_xp": {
                "const": 15
              }
            },
            "required": [
              "required_stages",
              "required_correct",
              "reward_xp"
            ]
          },
          "predict": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "predict",
                  "guided",
                  "transfer",
                  "exit"
