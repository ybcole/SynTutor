                    ]
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "node_id",
                  "field",
                  "expected"
                ]
              }
            },
            "required": [
              "id",
              "prompt",
              "options",
              "answer",
              "hint",
              "source_ids",
              "outcome_ids"
            ]
          }
        },
        "required": [
