              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "enum": [
                        "a",
                        "b",
                        "c"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "feedback": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "feedback"
                  ]
                }
              },
              "answer": {
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              },
              "hint": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "outcome_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "build_target": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "enum": [
                      "label",
                      "feature"
                    ]
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "node_id",
                  "field",
                  "expected"
                ]
              }
            },
            "required": [
              "id",
              "prompt",
              "options",
              "answer",
              "hint",
              "source_ids",
              "outcome_ids"
            ]
          },
          "guided": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "predict",
                  "guided",
                  "transfer",
                  "exit"
                ]
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "enum": [
                        "a",
                        "b",
                        "c"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "feedback": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "feedback"
                  ]
                }
              },
              "answer": {
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              },
              "hint": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "outcome_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "build_target": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "enum": [
                      "label",
                      "feature"
                    ]
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "node_id",
                  "field",
                  "expected"
                ]
              }
            },
            "required": [
              "id",
              "prompt",
              "options",
              "answer",
              "hint",
              "source_ids",
              "outcome_ids"
            ]
          },
          "transfer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "predict",
                  "guided",
                  "transfer",
                  "exit"
                ]
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "enum": [
                        "a",
                        "b",
                        "c"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "feedback": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "feedback"
                  ]
                }
              },
              "answer": {
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              },
              "hint": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "outcome_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "build_target": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "enum": [
                      "label",
                      "feature"
                    ]
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "node_id",
                  "field",
                  "expected"
                ]
              }
            },
            "required": [
              "id",
              "prompt",
              "options",
              "answer",
              "hint",
              "source_ids",
              "outcome_ids"
            ]
          },
          "exit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "predict",
                  "guided",
                  "transfer",
                  "exit"
                ]
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "enum": [
                        "a",
                        "b",
                        "c"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "feedback": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "feedback"
                  ]
                }
              },
              "answer": {
                "enum": [
                  "a",
                  "b",
                  "c"
                ]
              },
              "hint": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "outcome_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "build_target": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "node_id": {
                    "type": "string",
