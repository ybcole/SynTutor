          "title",
          "track",
          "chapter",
          "content_version",
          "difficulty",
          "estimated_minutes",
          "prerequisites",
          "outcomes",
          "convention_profile",
          "tree_ids",
          "concept_ids",
          "rule_ids",
          "source_ids",
          "publication_status",
          "review_status",
          "independent_review",
          "reviewed_by",
          "reviewed_on",
          "review_receipt",
          "teaching",
          "worked_example",
          "cambridge_insights",
          "completion",
          "predict",
          "guided",
          "transfer",
          "exit"
