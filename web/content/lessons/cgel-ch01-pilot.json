{
  "title": "Preliminaries",
  "content_version": "3.1.0",
  "estimated_minutes": 20,
  "outcomes": [
    {
      "id": "o1",
      "text": "Explain the main ideas in Preliminaries."
    },
    {
      "id": "o2",
      "text": "Recognise the patterns in real sentences."
    },
    {
      "id": "o3",
      "text": "Use the ideas when you read and write."
    }
  ],
  "key_terms": [
    {
      "term": "descriptive grammar",
      "definition": "An account of how speakers actually use a language."
    },
    {
      "term": "register",
      "definition": "A way of using language that suits a particular situation."
    },
    {
      "term": "accent",
      "definition": "How speech sounds are pronounced."
    },
    {
      "term": "dialect",
      "definition": "A variety that differs in vocabulary and grammar as well as pronunciation."
    },
    {
      "term": "lexeme",
      "definition": "A word as a dictionary entry, apart from its different forms."
    },
    {
      "term": "word token",
      "definition": "One occurrence of a word in speech or writing."
    },
    {
      "term": "inflection",
      "definition": "An ending that marks a grammatical feature such as tense or number."
    },
    {
      "term": "constituent",
      "definition": "A word or group that behaves as one unit inside a larger structure."
    },
    {
      "term": "head",
      "definition": "The central word of a phrase."
    },
    {
      "term": "complement",
      "definition": "A dependent that fills a slot the head requires."
    },
    {
      "term": "modifier",
      "definition": "A dependent that adds information without filling a required slot."
    },
    {
      "term": "determinative",
      "definition": "A word such as the, a or this that helps identify a noun phrase."
    },
    {
      "term": "preterite",
      "definition": "The verb form often used for past time, as in lived or went."
    },
    {
      "term": "entailment",
      "definition": "A meaning that must be true whenever the original statement is true."
    },
    {
      "term": "implicature",
      "definition": "A meaning a speaker suggests without stating it."
    },
    {
      "term": "presupposition",
      "definition": "Information a sentence takes for granted."
    }
  ],
