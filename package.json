{
  "name": "syntutor",
  "version": "2.0.0",
  "description": "SynTutor - explainable tutoring system for English phrase-structure syntax (spaCy + benepar backend, rule-matrix XAI)",
  "type": "module",
  "scripts": {
    "build": "python3 scripts/tree_sheet.py && node scripts/build.js",
    "serve": "python3 server/webapp.py",
    "serve:legacy": "python3 server/app.py",
    "audit": "python3 scripts/audit_rules.py",
    "test:quiz": "node scripts/test_tree_quiz.js",
    "test:correction": "node scripts/test_correction.js",
    "sheet": "python3 scripts/master_sheet.py",
    "tree:sheet": "python3 scripts/tree_sheet.py",
    "explanation-sheet": "python3 scripts/explanation_sheet.py",
    "remediation-sheet": "python3 scripts/remediation_sheet.py",
    "test:rules": "python3 scripts/smoke_rules.py",
    "test:evidence": "node scripts/test_explanation_evidence.js",
    "test:lessons": "node scripts/test_lesson_progress.js && node scripts/test_lesson_database.js",
    "test:assessments": "node scripts/test_assessment_core.js && node scripts/test_assessment_database.js",
    "test:builder": "node scripts/test_builder_core.js",
    "test:legacy-map": "node scripts/test_legacy_node_map.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15"
  }
}
