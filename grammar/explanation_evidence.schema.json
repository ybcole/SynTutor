{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "NO_BOOK_BASIS",
        "ANALYSIS_UNRESOLVED",
        "SOURCE_CONFLICT",
        "EXPLAINED"
      ]
    },
    "analysis_status": {
      "type": "string"
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structural": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "template_id": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "deep_text": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "book": {
                      "enum": [
                        "B-R",
                        "Cambridge"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "edition": {
                      "type": "string"
                    },
                    "printed_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "evidence_status": {
                      "enum": [
                        "IMG",
                        "TXT",
                        "NEEDS_REVIEW"
                      ]
                    },
                    "status": {
                      "enum": [
                        "approved",
                        "pending",
                        "rejected"
                      ]
                    },
                    "crosswalk_status": {
                      "enum": [
                        "compatible",
                        "resolved",
                        "unverified",
                        "conflict"
                      ]
                    },
                    "review_status": {
                      "enum": [
                        "NOT_REVIEWED",
                        "INDEPENDENTLY_REVIEWED",
                        "HUMAN_APPROVED",
                        "REJECTED"
                      ]
                    },
                    "independent_review": {
                      "type": "boolean"
                    },
                    "reviewed_by": {
                      "type": "string"
                    },
                    "reviewed_on": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "book",
                    "title",
                    "edition",
                    "printed_page",
                    "evidence_status",
                    "status",
                    "crosswalk_status",
                    "review_status",
                    "independent_review",
                    "reviewed_by",
                    "reviewed_on"
                  ]
                }
              },
              "facts": {
                "type": "object"
              }
            },
            "required": [
              "template_id",
              "node_id",
              "text",
              "deep_text",
              "sources",
              "facts"
            ]
          }
        },
        "grammatical": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "template_id": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "deep_text": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "book": {
                      "enum": [
                        "B-R",
                        "Cambridge"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "edition": {
                      "type": "string"
                    },
                    "printed_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "evidence_status": {
                      "enum": [
                        "IMG",
                        "TXT",
                        "NEEDS_REVIEW"
                      ]
                    },
                    "status": {
                      "enum": [
                        "approved",
                        "pending",
                        "rejected"
                      ]
                    },
                    "crosswalk_status": {
                      "enum": [
                        "compatible",
                        "resolved",
                        "unverified",
                        "conflict"
                      ]
                    },
                    "review_status": {
                      "enum": [
                        "NOT_REVIEWED",
                        "INDEPENDENTLY_REVIEWED",
                        "HUMAN_APPROVED",
                        "REJECTED"
                      ]
                    },
                    "independent_review": {
                      "type": "boolean"
                    },
                    "reviewed_by": {
                      "type": "string"
                    },
                    "reviewed_on": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "book",
                    "title",
                    "edition",
                    "printed_page",
                    "evidence_status",
                    "status",
                    "crosswalk_status",
                    "review_status",
                    "independent_review",
                    "reviewed_by",
                    "reviewed_on"
                  ]
                }
              },
              "facts": {
                "type": "object"
              }
            },
            "required": [
              "template_id",
              "node_id",
              "text",
              "deep_text",
              "sources",
              "facts"
            ]
          }
        },
        "remediation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "template_id": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "deep_text": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "book": {
                      "enum": [
                        "B-R",
                        "Cambridge"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "edition": {
                      "type": "string"
                    },
                    "printed_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "evidence_status": {
                      "enum": [
                        "IMG",
                        "TXT",
                        "NEEDS_REVIEW"
                      ]
                    },
                    "status": {
                      "enum": [
                        "approved",
                        "pending",
                        "rejected"
                      ]
                    },
                    "crosswalk_status": {
                      "enum": [
                        "compatible",
                        "resolved",
                        "unverified",
                        "conflict"
                      ]
                    },
                    "review_status": {
                      "enum": [
                        "NOT_REVIEWED",
                        "INDEPENDENTLY_REVIEWED",
                        "HUMAN_APPROVED",
                        "REJECTED"
                      ]
                    },
                    "independent_review": {
                      "type": "boolean"
                    },
                    "reviewed_by": {
                      "type": "string"
                    },
                    "reviewed_on": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "book",
                    "title",
                    "edition",
                    "printed_page",
                    "evidence_status",
                    "status",
                    "crosswalk_status",
                    "review_status",
                    "independent_review",
                    "reviewed_by",
                    "reviewed_on"
                  ]
                }
              },
              "facts": {
                "type": "object"
              }
            },
            "required": [
              "template_id",
              "node_id",
              "text",
              "deep_text",
              "sources",
              "facts"
            ]
          }
        }
      },
      "required": [
        "structural",
        "grammatical",
        "remediation"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "fact_graph": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "language_policy",
            "status",
            "nodes",
            "edges",
            "atoms",
            "token_index",
            "alternatives",
            "movement_links"
          ],
          "properties": {
            "schema_version": {
              "const": "xai-facts-2.0.0"
            },
            "language_policy": {
              "const": "ENGLISH_ONLY"
            },
            "status": {
              "enum": [
                "observed",
                "provisional",
                "unavailable"
              ]
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "contextual_explanations": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "status",
            "items",
            "language_policy",
            "scope"
          ],
          "properties": {
            "schema_version": {
              "const": "xai-composer-3.0.0"
            },
            "language_policy": {
              "const": "ENGLISH_ONLY"
            },
            "status": {
              "enum": [
                "observed",
                "provisional",
                "unavailable"
              ]
            },
            "items": {
              "type": "array"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "xai4_partial_evaluation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "language_policy",
            "status",
            "enabled_rule_ids",
            "evaluations",
            "findings",
            "global_verdict",
            "token_index_basis"
          ],
          "properties": {
            "schema_version": {
              "const": "xai4-partial-1.0.0"
            },
            "language_policy": {
              "const": "ENGLISH_ONLY"
            },
            "status": {
              "type": "string"
            },
            "enabled_rule_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "findings": {
              "type": "array"
            },
            "evaluations": {
              "type": "array"
            },
            "token_index_basis": {
              "const": "XAI4_RAW_SOURCE_TOKENS_NOT_BR_NODES"
            },
            "global_verdict": {
              "type": "object",
              "required": [
                "status",
                "whole_sentence_certified"
              ],
              "properties": {
                "whole_sentence_certified": {
                  "const": false
                }
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "xai5_localization": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "language_policy",
            "observations",
            "diagnoses",
            "whole_sentence_certified"
          ],
          "properties": {
            "schema_version": {
              "const": "xai5-repair-1.0.0"
            },
            "language_policy": {
              "const": "ENGLISH_ONLY"
            },
            "observations": {
              "type": "array"
            },
            "diagnoses": {
              "type": "array"
            },
            "whole_sentence_certified": {
              "const": false
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "xai6_naturalization": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "language_policy",
            "status",
            "reason_code",
            "selected_node_id",
            "paragraphs",
            "whole_sentence_certified"
          ],
          "properties": {
            "schema_version": {
              "const": "xai6-result-1.0.0"
            },
            "language_policy": {
              "const": "ENGLISH_ONLY"
            },
            "status": {
              "enum": [
                "disabled",
                "unavailable",
                "fallback",
                "accepted"
              ]
            },
            "reason_code": {
              "type": "string"
            },
            "selected_node_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "paragraphs": {
              "type": "array"
            },
            "whole_sentence_certified": {
              "const": false
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "xai7_unified": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "title": "SynTutor XAI-7 shared tree/quiz UI evidence focus",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "language_policy",
            "mode",
            "analysis_id",
            "tree_status",
            "selected_node_id",
            "focus",
            "feature_rows",
            "verified_issues",
            "citations",
            "contextual_status",
            "book_status",
            "claim_boundary",
            "whole_sentence_certified"
          ],
          "properties": {
            "schema_version": {
              "const": "xai7-evidence-1.0.0"
            },
            "language_policy": {
              "const": "ENGLISH_ONLY"
            },
            "mode": {
              "enum": [
                "tree",
                "quiz"
              ]
            },
            "analysis_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "tree_status": {
              "enum": [
                "observed",
                "provisional",
                "unavailable"
              ]
            },
            "selected_node_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "focus": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node_id",
                  "reason",
                  "relation_authority"
                ],
                "properties": {
                  "node_id": {
                    "type": "string"
                  },
                  "reason": {
                    "enum": [
                      "selected",
                      "parent",
                      "sibling",
                      "approved_governor",
                      "approved_affected"
                    ]
                  },
                  "relation_authority": {
                    "enum": [
                      "approved_rule",
                      "witnessed_tree_position"
                    ]
                  }
                }
              },
              "uniqueItems": true
            },
            "feature_rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node_id",
                  "feature",
                  "status"
                ],
                "properties": {
                  "node_id": {
                    "type": "string"
                  },
                  "feature": {
                    "type": "string"
                  },
                  "status": {
                    "const": "observed_label_not_a_verified_function"
                  }
                }
              }
            },
            "verified_issues": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "finding_id",
                  "rule_id",
                  "governor_node_id",
                  "affected_node_id",
                  "affected_char_span",
                  "status"
                ],
                "properties": {
                  "finding_id": {
                    "type": "string"
                  },
                  "rule_id": {
                    "type": "string"
                  },
                  "governor_node_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "affected_node_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "affected_char_span": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "status": {
                    "const": "verified_local_violation"
                  }
                }
              }
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "channel",
                  "source_id",
                  "book",
                  "title",
                  "edition",
                  "printed_page",
                  "node_id"
                ],
                "properties": {
                  "channel": {
                    "enum": [
                      "structural",
                      "grammatical",
                      "remediation"
                    ]
                  },
                  "source_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "book": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "edition": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "printed_page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "node_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "contextual_status": {
              "enum": [
                "observed",
                "provisional",
                "unavailable"
              ]
            },
            "book_status": {
              "enum": [
                "EXPLAINED",
                "NO_BOOK_BASIS",
                "ANALYSIS_UNRESOLVED",
                "SOURCE_CONFLICT"
              ]
            },
            "claim_boundary": {
              "const": "observations_do_not_create_new_functions_or_grammar_verdicts"
            },
            "whole_sentence_certified": {
              "const": false
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "analysis_status",
    "channels",
    "facts",
    "diagnostics"
  ]
}
