{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "NO_BOOK_BASIS",
        "ANALYSIS_UNRESOLVED",
        "SOURCE_CONFLICT",
        "EXPLAINED"
      ]
    },
    "analysis_status": {
      "type": "string"
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structural": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "template_id": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "deep_text": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "book": {
                      "enum": [
                        "B-R",
                        "Cambridge"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "edition": {
                      "type": "string"
                    },
                    "printed_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "evidence_status": {
                      "enum": [
                        "IMG",
                        "TXT",
                        "NEEDS_REVIEW"
                      ]
                    },
                    "status": {
                      "enum": [
                        "approved",
                        "pending",
                        "rejected"
                      ]
                    },
                    "crosswalk_status": {
                      "enum": [
                        "compatible",
                        "resolved",
                        "unverified",
                        "conflict"
                      ]
                    },
                    "review_status": {
                      "enum": [
                        "NOT_REVIEWED",
                        "INDEPENDENTLY_REVIEWED",
                        "HUMAN_APPROVED",
                        "REJECTED"
                      ]
                    },
                    "independent_review": {
                      "type": "boolean"
                    },
                    "reviewed_by": {
                      "type": "string"
                    },
                    "reviewed_on": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "book",
                    "title",
                    "edition",
                    "printed_page",
                    "evidence_status",
                    "status",
                    "crosswalk_status",
                    "review_status",
                    "independent_review",
                    "reviewed_by",
                    "reviewed_on"
                  ]
                }
              },
              "facts": {
                "type": "object"
              }
            },
            "required": [
              "template_id",
              "node_id",
              "text",
              "deep_text",
              "sources",
              "facts"
            ]
          }
        },
        "grammatical": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "template_id": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "deep_text": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "book": {
                      "enum": [
                        "B-R",
                        "Cambridge"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "edition": {
                      "type": "string"
                    },
                    "printed_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "evidence_status": {
                      "enum": [
                        "IMG",
                        "TXT",
                        "NEEDS_REVIEW"
                      ]
                    },
                    "status": {
                      "enum": [
                        "approved",
                        "pending",
                        "rejected"
                      ]
                    },
                    "crosswalk_status": {
                      "enum": [
                        "compatible",
                        "resolved",
                        "unverified",
                        "conflict"
                      ]
                    },
                    "review_status": {
                      "enum": [
                        "NOT_REVIEWED",
                        "INDEPENDENTLY_REVIEWED",
                        "HUMAN_APPROVED",
                        "REJECTED"
                      ]
                    },
                    "independent_review": {
                      "type": "boolean"
                    },
                    "reviewed_by": {
                      "type": "string"
                    },
                    "reviewed_on": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "book",
                    "title",
                    "edition",
                    "printed_page",
                    "evidence_status",
                    "status",
                    "crosswalk_status",
                    "review_status",
                    "independent_review",
                    "reviewed_by",
                    "reviewed_on"
                  ]
                }
              },
              "facts": {
                "type": "object"
              }
            },
            "required": [
              "template_id",
              "node_id",
              "text",
              "deep_text",
              "sources",
              "facts"
            ]
          }
        },
        "remediation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "template_id": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "deep_text": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "book": {
                      "enum": [
                        "B-R",
                        "Cambridge"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "edition": {
                      "type": "string"
                    },
                    "printed_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "evidence_status": {
                      "enum": [
                        "IMG",
                        "TXT",
                        "NEEDS_REVIEW"
                      ]
                    },
                    "status": {
                      "enum": [
                        "approved",
                        "pending",
                        "rejected"
                      ]
                    },
                    "crosswalk_status": {
                      "enum": [
                        "compatible",
                        "resolved",
                        "unverified",
                        "conflict"
                      ]
                    },
                    "review_status": {
                      "enum": [
                        "NOT_REVIEWED",
                        "INDEPENDENTLY_REVIEWED",
                        "HUMAN_APPROVED",
                        "REJECTED"
                      ]
                    },
                    "independent_review": {
                      "type": "boolean"
                    },
                    "reviewed_by": {
                      "type": "string"
                    },
                    "reviewed_on": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "book",
                    "title",
                    "edition",
                    "printed_page",
                    "evidence_status",
                    "status",
                    "crosswalk_status",
                    "review_status",
                    "independent_review",
                    "reviewed_by",
                    "reviewed_on"
                  ]
                }
              },
              "facts": {
                "type": "object"
              }
            },
            "required": [
              "template_id",
              "node_id",
              "text",
              "deep_text",
              "sources",
              "facts"
            ]
          }
        }
      },
      "required": [
        "structural",
        "grammatical",
        "remediation"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "fact_graph": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "language_policy",
            "status",
            "nodes",
            "edges",
            "atoms",
            "token_index",
            "alternatives",
            "movement_links"
          ],
          "properties": {
            "schema_version": {
              "const": "xai-facts-2.0.0"
            },
            "language_policy": {
              "const": "ENGLISH_ONLY"
            },
            "status": {
              "enum": [
                "observed",
                "provisional",
                "unavailable"
              ]
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "contextual_explanations": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "status",
            "items",
            "language_policy",
            "scope"
          ],
          "properties": {
            "schema_version": {
              "const": "xai-composer-3.0.0"
            },
            "language_policy": {
              "const": "ENGLISH_ONLY"
            },
            "status": {
              "enum": [
                "observed",
                "provisional",
                "unavailable"
              ]
            },
            "items": {
              "type": "array"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "xai4_partial_evaluation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "language_policy",
            "status",
            "enabled_rule_ids",
            "evaluations",
            "findings",
            "global_verdict",
            "token_index_basis"
          ],
          "properties": {
            "schema_version": {
              "const": "xai4-partial-1.0.0"
            },
            "language_policy": {
              "const": "ENGLISH_ONLY"
            },
            "status": {
              "type": "string"
            },
            "enabled_rule_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "findings": {
              "type": "array"
            },
            "evaluations": {
              "type": "array"
            },
            "token_index_basis": {
              "const": "XAI4_RAW_SOURCE_TOKENS_NOT_BR_NODES"
            },
            "global_verdict": {
              "type": "object",
              "required": [
                "status",
                "whole_sentence_certified"
              ],
              "properties": {
                "whole_sentence_certified": {
                  "const": false
                }
              }
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "analysis_status",
    "channels",
    "facts",
    "diagnostics"
  ]
}
