{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "book": {
            "enum": [
              "B-R",
              "Cambridge"
            ]
          },
          "title": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "printed_page": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_status": {
            "enum": [
              "IMG",
              "TXT",
              "NEEDS_REVIEW"
            ]
          },
          "status": {
            "enum": [
              "approved",
              "pending",
              "rejected"
            ]
          },
          "crosswalk_status": {
            "enum": [
              "compatible",
              "resolved",
              "unverified",
              "conflict"
            ]
          },
          "review_status": {
            "enum": [
              "NOT_REVIEWED",
              "INDEPENDENTLY_REVIEWED",
              "HUMAN_APPROVED",
              "REJECTED"
            ]
          },
          "independent_review": {
            "type": "boolean"
          },
          "reviewed_by": {
            "type": "string"
          },
          "reviewed_on": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "book",
          "title",
          "edition",
          "printed_page",
          "evidence_status",
          "status",
          "crosswalk_status",
          "review_status",
          "independent_review",
          "reviewed_by",
          "reviewed_on"
        ]
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "enum": [
              "structural",
              "grammatical",
              "remediation"
            ]
          },
          "node_label": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "deep_text": {
            "type": "string"
          },
          "claim_key": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "review_status": {
            "enum": [
              "NOT_REVIEWED",
              "INDEPENDENTLY_REVIEWED",
              "HUMAN_APPROVED",
              "REJECTED"
            ]
          },
          "independent_review": {
            "type": "boolean"
          },
          "reviewed_by": {
            "type": "string"
          },
          "reviewed_on": {
            "type": "string"
          },
          "when": {
            "enum": [
              "passed",
              "violation",
              "exception"
            ]
          },
          "claim_type": {
            "enum": [
              "classification",
              "descriptive_generalization",
              "constraint",
              "variety_restricted"
            ]
          },
          "node_children_labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "channel",
          "node_label",
          "source_ids",
          "text",
          "review_status",
          "independent_review",
          "reviewed_by",
          "reviewed_on"
        ]
      }
    }
  },
  "required": [
    "version",
    "sources",
    "templates"
  ]
}
